   local function projectGroundBelowPoint(goalPos, extraIgnore)
       local origin = goalPos + Vector3.new(0, 2, 0)
       local result = workspace:Raycast(origin, Vector3.new(0, -18, 0), buildBotRaycastParams(extraIgnore))
       if result then
           return result.Position
       end
       return projectBotGoalToGround(goalPos, extraIgnore)
   end
   local function getCheckpointNodes()
       local unbreakable = workspace:FindFirstChild("Unbreakable")
       local folder = unbreakable and unbreakable:FindFirstChild("Checkpoints")
       if not folder then
           _checkpointNodeCache.folder = nil
           _checkpointNodeCache.childCount = -1
           _checkpointNodeCache.nodes = nil
           return nil
       end
       local children = folder:GetChildren()
       local childCount = #children
       if _checkpointNodeCache.folder == folder
           and _checkpointNodeCache.childCount == childCount
           and _checkpointNodeCache.nodes then
           return _checkpointNodeCache.nodes
       end
       local nodes = {}
       for _, checkpoint in ipairs(children) do
           local part = nil
           if checkpoint:IsA("BasePart") then
               part = checkpoint
           else
               for _, desc in ipairs(checkpoint:GetDescendants()) do
                   if desc:IsA("BasePart") then
                       part = desc
                       break
                   end
               end
           end
           if part then
               nodes[checkpoint.Name] = {
                   name = checkpoint.Name,
                   instance = checkpoint,
                   part = part,
                   pos = part.Position,
                   neighbors = {},
               }
           end
       end
      for name, node in pairs(nodes) do
          for _, child in ipairs(node.instance:GetDescendants()) do
              if child:IsA("StringValue") and nodes[child.Value] then
                  table.insert(node.neighbors, child.Value)
              end
          end
      end
      _checkpointNodeCache.folder = folder
      _checkpointNodeCache.childCount = childCount
      _checkpointNodeCache.nodes = nodes
      return nodes
   end
   local function getNearestCheckpointName(position, nodes, extraIgnore)
      local bestVisibleName, bestVisibleScore = nil, math.huge
      local bestName, bestDist = nil, math.huge
      for name, node in pairs(nodes) do
          local samplePos = node.pos + Vector3.new(0, 3, 0)
          local dist = (position - samplePos).Magnitude
          if dist < bestDist then
              bestName = name
              bestDist = dist
          end
          if dist <= 300 then
              local visiblePenalty = canBotSeePosition(position, samplePos, extraIgnore) and 0 or 300
              local verticalPenalty = math.abs(samplePos.Y - position.Y) * 1.5
              local score = dist + visiblePenalty + verticalPenalty
              if score < bestVisibleScore then
                  bestVisibleName = name
                  bestVisibleScore = score
              end
          end
      end
      return bestVisibleName or bestName
   end
   local function reconstructCheckpointRoute(cameFrom, currentName)
       local route = {currentName}
       while cameFrom[currentName] do
           currentName = cameFrom[currentName]
           table.insert(route, 1, currentName)
       end
       return route
   end
   local function getCheckpointRoute(startName, goalName, nodes)
       if not startName or not goalName or not nodes[startName] or not nodes[goalName] then return nil end
       local open = {startName}
       local cameFrom = {}
       local gScore = {[startName] = 0}
       local fScore = {[startName] = (nodes[startName].pos - nodes[goalName].pos).Magnitude}
       while #open > 0 do
           table.sort(open, function(a, b)
               return (fScore[a] or math.huge) < (fScore[b] or math.huge)
           end)
           local current = table.remove(open, 1)
           if current == goalName then
               return reconstructCheckpointRoute(cameFrom, current)
           end
           for _, neighborName in ipairs(nodes[current].neighbors) do
               local tentative = (gScore[current] or math.huge) + (nodes[current].pos - nodes[neighborName].pos).Magnitude
               if tentative < (gScore[neighborName] or math.huge) then
                   cameFrom[neighborName] = current
                   gScore[neighborName] = tentative
                   fScore[neighborName] = tentative + (nodes[neighborName].pos - nodes[goalName].pos).Magnitude
                   if not table.find(open, neighborName) then
                       table.insert(open, neighborName)
                   end
               end
           end
       end
       return nil
   end
   local function getCheckpointAdvanceGoal(rootPos, goalPos, extraIgnore)
       local nodes = getCheckpointNodes()
       if not nodes then return nil end
       local startName = getNearestCheckpointName(rootPos, nodes, extraIgnore)
       local goalName = getNearestCheckpointName(goalPos, nodes, extraIgnore)
       local route = getCheckpointRoute(startName, goalName, nodes)
       if not route or #route == 0 then return nil end
       local bestPos = nil
       local furthestIndex = math.min(#route, 4)
       for idx = 1, furthestIndex do
           local node = nodes[route[idx]]
           if node then
               if idx == 1 or canBotSeePosition(rootPos, node.pos, extraIgnore) then
                   bestPos = node.pos
               else
                   break
               end
           end
       end
       if not bestPos or (bestPos - rootPos).Magnitude < 8 then
           local fallbackIndex = math.min(#route, math.max(2, furthestIndex))
           local fallbackNode = nodes[route[fallbackIndex]]
           bestPos = fallbackNode and fallbackNode.pos or bestPos
       end
       return bestPos
   end
   local function getIntermediateAdvanceGoals(rootPos, goalPos, extraIgnore)
       local dist = (goalPos - rootPos).Magnitude
       if dist < 80 then return {} end
       local dir = (goalPos - rootPos).Unit
       local right = Vector3.new(-dir.Z, 0, dir.X)
       if right.Magnitude < 0.01 then
           right = Vector3.new(1, 0, 0)
       else
           right = right.Unit
       end
       local candidates = {}
       for _, stepDist in ipairs({math.min(dist * 0.25, 90), math.min(dist * 0.45, 160), math.min(dist * 0.65, 230)}) do
           for _, lateral in ipairs({0, 16, -16, 30, -30}) do
               local sample = rootPos + dir * stepDist + right * lateral
               local projected = projectGroundBelowPoint(sample, extraIgnore)
               table.insert(candidates, projected)
           end
       end
       return candidates
   end
   local function tryComputePathWaypoints(rootPos, pathGoalPos, config, extraIgnore)
       local path = _PathfindingService:CreatePath({
           AgentRadius = config.agentRadius,
           AgentHeight = config.agentHeight,
           AgentCanJump = true,
           AgentCanClimb = true,
           WaypointSpacing = config.waypointSpacing,
       })
       local ok = pcall(function()
           path:ComputeAsync(rootPos, pathGoalPos)
       end)
       if ok and path.Status == Enum.PathStatus.Success then
           local waypoints = path:GetWaypoints()
           if #waypoints > 0 then
               return waypoints
           end
       end
       return nil
   end
