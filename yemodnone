                       cleanupNpcFarm()
                       spawnNotification("NPC farm starting! Preparing...")
                       S.npcIsFollowing = true
                       task.wait(1)
                        -- Auto AutoDupe and Auto Invis start simultaneously
                       local dupeFinished = true
                       local invisFinished = true
                       if S.autoReorderNpcEnabled and S.autofarmNpcEnabled then
                           dupeFinished = false
                           task.spawn(function()
                               spawnNotification("AutoDuping weapons...")
                                  S._performReorder(S.autoReorderNpcAmount, function() return S.autofarmNpcEnabled end)
