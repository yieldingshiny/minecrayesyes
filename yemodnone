   -- ======= TWEEN FARM LOOP ======= --
   -- Enables noclip while tweening to gems, disables + teleports to demon safe spot when done
   task.spawn(function()
       local activeTween = nil
       local lastGemTarget = nil
       local tweenNoclipActive = false -- tracks if WE enabled noclip for tween farming
       local _DEMON_SAFE_SPOT = CFrame.new(-2044.74548, 499.961731, -1937.68774)
       while true do
           if S.tweenFarmEnabled and not S.demonIsFollowing and not S.generalIsFollowing and not S.npcIsFollowing then
               local char = _Players.LocalPlayer.Character
               local root = char and char:FindFirstChild("HumanoidRootPart")
               local hum = char and char:FindFirstChild("Humanoid")
               if root and hum and hum.Health > 0 then
                   local bestGem = getBestGem()
                   if bestGem then
                       -- Enable noclip when we start collecting gems
                       if not tweenNoclipActive then
                           enableNoclip()
                           tweenNoclipActive = true
                       end
                       -- Constantly update position to follow the gem (e.g. falling from sky)
                       local gemPos = bestGem.CFrame + Vector3.new(0, 2, 0)
                       local dist = (root.Position - gemPos.Position).Magnitude
                       if dist > 1 then
                           -- Cancel old tween if gem changed or moved significantly
                           if activeTween then
                               activeTween:Cancel()
                               activeTween = nil
                           end
                           local tweenTime = math.clamp(dist / S.gemTweenSpeed, 0.05, 2)
                           activeTween = _TweenService:Create(root, TweenInfo.new(tweenTime, Enum.EasingStyle.Linear), {
                               CFrame = gemPos
                           })
                           activeTween:Play()
                       end
                       lastGemTarget = bestGem
                   else
                       -- No gems left: disable noclip and teleport to demon safe spot
                       if activeTween then activeTween:Cancel() activeTween = nil end
                       lastGemTarget = nil
                       if tweenNoclipActive then
                           disableNoclip()
                           tweenNoclipActive = false
                           if root then
                               root.CFrame = _DEMON_SAFE_SPOT
                               breakVelocity(root)
                           end
                       end
                   end
               end
           else
               if activeTween then activeTween:Cancel() activeTween = nil end
               lastGemTarget = nil
               if tweenNoclipActive then
                   disableNoclip()
                   tweenNoclipActive = false
               end
           end
           task.wait(0.1)
       end
   end)
