                                   if hum then
                                       local ms = hum:FindFirstChild("MaxSpeed")
                                       if ms and ms:IsA("NumberValue") then
                                           return hum, ms
                                       end
                                   end
                               end
                           end
                       end
                   end
               end
           end
       end
       local char = lp.Character
       if char then
