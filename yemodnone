                           task.spawn(function()
                               -- If a previous invis thread is still shutting down, wait for it to clear
                               if S._invisThread and not S._invisEnabled then
                                   local clearWait = tick()
                                   while S._invisThread and tick() - clearWait < 5 do
                                       task.wait(0.2)
                                   end
                               end
                               if not S._invisEnabled then
                                   spawnNotification("Enabling Invis, please wait...")
                                   enableInvis()
                               end
                               -- Wait for invis to be fully ready (thread running + enabled)
                               local invisWaitStart = tick()
                               while (not S._invisThread or not S._invisEnabled) and S.autofarmNpcEnabled and tick() - invisWaitStart < 30 do
                                   task.wait(0.2)
                               end
                               if S._invisThread and S._invisEnabled then task.wait(1) end
                               invisFinished = true
                           end)
                       end
                       -- Wait for both to complete before proceeding
                       while S.autofarmNpcEnabled and (not dupeFinished or not invisFinished) do
                           task.wait(0.2)
                       end
                       npcSetupDone = true
                       -- Initialize hold position at current LIVE position (flat on back)
                       -- Re-read root position to ensure we use post-respawn location
                       local freshChar = _Players.LocalPlayer.Character
                       local freshRoot = freshChar and freshChar:FindFirstChild("HumanoidRootPart")
                       if freshRoot then
                           npcHoldCF = CFrame.new(freshRoot.Position) * CFrame.Angles(math.pi / 2, 0, 0)
                       else
                           npcHoldCF = CFrame.new(root.Position) * CFrame.Angles(math.pi / 2, 0, 0)
                       end
                       ensureHoldConnection()
                   end
                   -- Check if current target died — enemy General uses same recovery as Autofarm General
                   if currentNpcTarget and not isTargetAlive(currentNpcTarget) then
                       if string.find(currentNpcTarget.Name, "General", 1, true) then
                           cleanupNpcFarm()
                           npcSetupDone = false
                           npcTweening = false
                           spawnNotification("General died! 35s cooldown...")
