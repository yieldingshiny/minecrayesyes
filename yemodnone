-- Gem cache (shared between ESP, Farm, Bot to avoid repeated workspace scans)
local _cachedGems = {}
local _lastGemCacheTime = 0
local _GEM_CACHE_INTERVAL = 0.5
local function refreshGemCache()
   local now = tick()
   if now - _lastGemCacheTime < _GEM_CACHE_INTERVAL then return _cachedGems end
   _lastGemCacheTime = now
   local newCache = {}
   for _, obj in ipairs(workspace:GetDescendants()) do
       if obj:IsA("IntValue") and obj.Name == "GemType" then
           local gemPart = obj.Parent
           if gemPart and gemPart:IsA("BasePart") and gemPart.Transparency < 1 and gemPart.Parent ~= nil then
               table.insert(newCache, {part = gemPart, id = obj.Value})
           end
       end
   end
   _cachedGems = newCache
   return _cachedGems
end
-- Gem ESP tracers (beams from HRP to gems; respects Hide Common for unnamed gem types)
local gemTracerBeams = {}
local function cleanupAllGemTracers()
   for part, beam in pairs(gemTracerBeams) do
       pcall(function()
           if beam and beam.Parent then beam:Destroy() end
       end)
       pcall(function()
           if part and part.Parent then
               local a = part:FindFirstChild("_GemTracerAtt")
               if a then a:Destroy() end
           end
       end)
       gemTracerBeams[part] = nil
   end
end
_RunService.Heartbeat:Connect(function()
   if not S.gemEspEnabled or not S.gemTracerEnabled then
       if next(gemTracerBeams) ~= nil then cleanupAllGemTracers() end
       return
   end
   local lp = _Players.LocalPlayer
   local char = lp and lp.Character
   local root = char and char:FindFirstChild("HumanoidRootPart")
   if not root then
       cleanupAllGemTracers()
       return
   end
   local att0 = root:FindFirstChild("_GemTracerRootAtt")
   if not att0 then
       att0 = Instance.new("Attachment")
       att0.Name = "_GemTracerRootAtt"
       att0.Parent = root
   end
   local gems = refreshGemCache()
   local want = {}
   for _, gd in ipairs(gems) do
       local part = gd.part
       if part and part.Parent and part.Transparency < 1 then
           local isNamed = gemValues[gd.id] ~= nil
           if not (S.gemEspHideCommon and not isNamed) then
               want[part] = true
           end
       end
   end
   for part, beam in pairs(gemTracerBeams) do
       if not want[part] then
           pcall(function()
               if beam and beam.Parent then beam:Destroy() end
           end)
           pcall(function()
               if part and part.Parent then
                   local a = part:FindFirstChild("_GemTracerAtt")
                   if a then a:Destroy() end
               end
           end)
           gemTracerBeams[part] = nil
       end
   end
   for part in pairs(want) do
       local beam = gemTracerBeams[part]
       if not beam or not beam.Parent then
           local att1 = part:FindFirstChild("_GemTracerAtt")
           if not att1 then
               att1 = Instance.new("Attachment")
               att1.Name = "_GemTracerAtt"
               att1.Parent = part
           end
           beam = Instance.new("Beam")
           beam.Name = "GemTracerBeam"
           beam.Attachment0 = att0
           beam.Attachment1 = att1
           beam.FaceCamera = true
           beam.Width0 = 0.12
           beam.Width1 = 0.12
           beam.LightEmission = 0.45
           beam.Parent = root
           gemTracerBeams[part] = beam
       end
       beam.Color = ColorSequence.new(part.Color)
   end
end)
