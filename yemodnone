   local function serializeConfig(tbl)
       local parts = {}
       for k, v in pairs(tbl) do
           if type(v) == "table" then
               -- Serialize arrays as comma-separated strings with TABLE: prefix
               local items = {}
               for _, item in ipairs(v) do
                   table.insert(items, tostring(item))
               end
               table.insert(parts, k .. "=TABLE:" .. table.concat(items, ","))
           else
               table.insert(parts, k .. "=" .. tostring(v))
           end
       end
       return table.concat(parts, "\n")
   end
   local function deserializeConfig(str)
       local tbl = {}
       for line in str:gmatch("[^\n]+") do
           local k, v = line:match("^(.-)=(.+)$")
           if k and v then
               if v:sub(1, 6) == "TABLE:" then
                   -- Deserialize TABLE: prefix back into an array
                   local items = {}
                   local content = v:sub(7)
                   if content ~= "" then
                       for item in content:gmatch("[^,]+") do
                           table.insert(items, item)
                       end
                   end
                   tbl[k] = items
               elseif v == "true" then tbl[k] = true
               elseif v == "false" then tbl[k] = false
               else tbl[k] = tonumber(v) or v end
           end
       end
       return tbl
   end
   local function saveConfig(name)
       pcall(function()
           if not writefile then return end
           local data = serializeConfig(getAllStateValues())
           writefile(getConfigFilePath(name), data)
       end)
   end
