                       local maxSocketRetries = 10
                       for attempt = 1, maxSocketRetries do
                           if not S.autoEternalFireEnabled then break end
                           -- Re-fetch character root in case of respawn
                           char = _Players.LocalPlayer.Character
                           root = char and char:FindFirstChild("HumanoidRootPart")
                           if not root then break end
                           -- Find an empty socket (no Handle child)
                           local targetSocket = nil
                           pcall(function()
                               local unbreakable = workspace:FindFirstChild("Unbreakable")
                               local foundation = unbreakable and unbreakable:FindFirstChild("Foundation")
                               local yetiSockets = foundation and foundation:FindFirstChild("Yeti Sockets")
                               if yetiSockets then
                                   for _, socket in pairs(yetiSockets:GetChildren()) do
                                       if socket.Name == "Socket" and not socket:FindFirstChild("Handle") then
                                           targetSocket = socket
                                           break
                                       end
                                   end
                               end
                           end)
                           if not targetSocket then
                               -- (silently retrying - no empty sockets)
                               task.wait(1)
                               continue
                           end
                           -- Find a part to teleport to within the socket
                           local socketPart = nil
                           if targetSocket:IsA("BasePart") then
                               socketPart = targetSocket
                           elseif targetSocket.PrimaryPart then
                               socketPart = targetSocket.PrimaryPart
                           else
                               for _, child in pairs(targetSocket:GetDescendants()) do
                                   if child:IsA("BasePart") then socketPart = child break end
                               end
                           end
                           if socketPart then
                               -- Teleport INSIDE the socket (no Y offset) so the fire registers
                               root.CFrame = CFrame.new(socketPart.Position)
                               breakVelocity(root)
                               -- (silently teleported inside socket)
                               -- Wait for the socket to register the fire (Handle appears)
                               local socketWaitStart = tick()
                               local socketFilled = false
                               while S.autoEternalFireEnabled and tick() - socketWaitStart < 5 do
                                   if targetSocket:FindFirstChild("Handle") then
                                       socketFilled = true
                                       break
                                   end
                                   task.wait(0.2)
                               end
                               if socketFilled then
                                   -- Verify we actually gave our fire (check if we still have it)
                                   if not playerHasEternalFire() then
                                       spawnNotification("Eternal Fire placed in Socket!", "success")
                                       socketSuccess = true
                                       break
                                   else
                                       -- We still have the fire; a nearby socket may have gotten
                                       -- a handle from someone else. Keep retrying.
                                       -- (silently retrying - socket filled by someone else)
                                       -- continue to next attempt
                                   end
                               else
                                   -- Handle never appeared - check if we still hold the fire
                                   if playerHasEternalFire() then
                                       -- (silently retrying - socket didn't register)
                                       -- continue to next attempt
                                   else
                                       -- We no longer have the fire, so it went somewhere
                                       spawnNotification("Eternal Fire used (not on character anymore)", "success")
                                       socketSuccess = true
                                       break
                                   end
                               end
                           else
                               -- (silently retrying - no socket part found)
                           end
                           task.wait(0.5)
                       end
                       if not socketSuccess and S.autoEternalFireEnabled then
                           spawnNotification("Failed to place fire after " .. maxSocketRetries .. " attempts.", "error")
                       end
                       -- Step 3: Teleport back to original position
                       local charNow = _Players.LocalPlayer.Character
                       local rootNow = charNow and charNow:FindFirstChild("HumanoidRootPart")
                       if rootNow then
                           rootNow.CFrame = originalCFrame
                           breakVelocity(rootNow)
                           -- (silently returned to original position)
                       end
                       -- Step 4: Restore auto equip
                       if wasEquipOn then S.equipWeaponEnabled = true end
                       if wasGenEquipOn then S.generalEquipWeaponEnabled = true end
                       if wasDemonEquipOn then S.demonEquipWeaponEnabled = true end
                       if wasNpcEquipOn then S.npcEquipWeaponEnabled = true end
                       -- Small cooldown before scanning again
                       task.wait(2)
                   end
               end
           end)
       end
   end)
end
