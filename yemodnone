   -- Helper: find best gem (uses cached gems to avoid FPS drops)
   local function getBestGem()
       local gems = refreshGemCache()
       local targets = {}
       local unknowns = {}
       for _, gemData in ipairs(gems) do
           local gemPart = gemData.part
           if gemPart and gemPart.Parent and gemPart.Transparency < 1 then
               if selectedGems[gemData.id] then
                   table.insert(targets, gemPart)
               elseif S.gemTargetUnknowns then
                   table.insert(unknowns, gemPart)
               end
           end
       end
       local root = _Players.LocalPlayer.Character and _Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
       if #targets > 0 and root then
           local closest, dist = targets[1], math.huge
           for _, g in ipairs(targets) do
               local d = (root.Position - g.Position).Magnitude
               if d < dist then dist = d; closest = g end
           end
           return closest, false
       elseif #unknowns > 0 and root then
           local closest, dist = unknowns[1], math.huge
           for _, g in ipairs(unknowns) do
               local d = (root.Position - g.Position).Magnitude
               if d < dist then dist = d; closest = g end
           end
           return closest, true
       end
       return nil
   end
   local function getPathVisualBucket(ownerName)
       if not ownerName or ownerName == "" then
           return pathVisualsFolder
       end
       local bucket = pathVisualsFolder:FindFirstChild(ownerName)
       if not bucket then
           bucket = Instance.new("Folder")
           bucket.Name = ownerName
           bucket.Parent = pathVisualsFolder
       end
       return bucket
   end
   local function clearPathVisuals(ownerName)
       if not ownerName or ownerName == "" then
           pathVisualsFolder:ClearAllChildren()
           return
       end
       local bucket = pathVisualsFolder:FindFirstChild(ownerName)
       if bucket then
           bucket:ClearAllChildren()
       end
   end
   local function drawPath(waypoints, isUnknown, ownerName)
       local bucket = getPathVisualBucket(ownerName)
       bucket:ClearAllChildren()
       local lineColor = isUnknown and Color3.fromRGB(50, 200, 255) or Color3.fromRGB(50, 255, 50)
       for i = 1, #waypoints - 1 do
           local p1 = waypoints[i].Position
           local p2 = waypoints[i+1].Position
           local distance = (p1 - p2).Magnitude
           local steps = math.max(1, math.ceil(distance / 5.5))
           local lastPoint = p1
           for step = 1, steps do
               local point = p1:Lerp(p2, step / steps)
               local segmentDistance = (lastPoint - point).Magnitude
               if segmentDistance > 0.05 then
                   local line = Instance.new("Part")
                   line.Size = Vector3.new(0.24, 0.24, segmentDistance)
                   line.CFrame = CFrame.lookAt(lastPoint, point) * CFrame.new(0, 0, -segmentDistance / 2)
                   line.Anchored = true
                   line.CanCollide = false
                   line.Material = Enum.Material.Neon
                   line.Color = lineColor
                   line.Parent = bucket
               end
               lastPoint = point
           end
       end
   end
