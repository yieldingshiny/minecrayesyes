   local function findOppositeGeneral()
       local root = _Players.LocalPlayer.Character and _Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
       if not root then return nil, nil end
       local unbreakable = workspace:FindFirstChild("Unbreakable")
       local chars = unbreakable and unbreakable:FindFirstChild("Characters")
       if not chars then return nil, nil end
       local humanGeneral = chars:FindFirstChild("Human") and chars.Human:FindFirstChild("Human General")
       local orcGeneral = chars:FindFirstChild("Orc") and chars.Orc:FindFirstChild("Orc General")
       local targetGeneral = nil
       local playerTeam = _Players.LocalPlayer.Team
       if playerTeam then
           local teamName = playerTeam.Name:lower()
           if teamName:find("human") then
               targetGeneral = orcGeneral
           elseif teamName:find("orc") then
               targetGeneral = humanGeneral
           end
       end
       if not targetGeneral then
           if humanGeneral and orcGeneral then
               local hDist = humanGeneral.PrimaryPart and (root.Position - humanGeneral.PrimaryPart.Position).Magnitude or math.huge
               local oDist = orcGeneral.PrimaryPart and (root.Position - orcGeneral.PrimaryPart.Position).Magnitude or math.huge
               targetGeneral = hDist > oDist and humanGeneral or orcGeneral
           else
               targetGeneral = humanGeneral or orcGeneral
           end
       end
       if not targetGeneral then return nil, nil end
       local targetPart = targetGeneral.PrimaryPart
       if not targetPart then
           for _, partName in ipairs({"HumanoidRootPart", "Torso", "LowerTorso", "UpperTorso", "Head"}) do
               local found = targetGeneral:FindFirstChild(partName)
               if found and found:IsA("BasePart") then targetPart = found break end
           end
       end
       return targetGeneral, targetPart
   end
