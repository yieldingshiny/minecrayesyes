-- ======= AUTOFARM WEAPON BORROWING ======= --
-- Returns a weapon list for the given autofarm, borrowing from others if empty.
-- sourceName: "General", "Demon", or "NPC"
-- Only sends notification once per autofarm session to avoid spam.
local _weaponBorrowNotified = {}
local function resolveAutofarmWeapons(sourceName)
   local ownWeapons, otherSources
   if sourceName == "General" then
       ownWeapons = S.generalAutoFarmWeapons
       otherSources = {
           {weapons = S.demonAutoFarmWeapons, name = "Demon Autofarm"},
           {weapons = S.npcAutoFarmWeapons, name = "NPC Autofarm"},
           {weapons = S.selectedWeapons, name = "Weapons tab"},
       }
   elseif sourceName == "Demon" then
       ownWeapons = S.demonAutoFarmWeapons
       otherSources = {
           {weapons = S.generalAutoFarmWeapons, name = "General Autofarm"},
           {weapons = S.npcAutoFarmWeapons, name = "NPC Autofarm"},
           {weapons = S.selectedWeapons, name = "Weapons tab"},
       }
   elseif sourceName == "NPC" then
       ownWeapons = S.npcAutoFarmWeapons
       otherSources = {
           {weapons = S.generalAutoFarmWeapons, name = "General Autofarm"},
           {weapons = S.demonAutoFarmWeapons, name = "Demon Autofarm"},
           {weapons = S.selectedWeapons, name = "Weapons tab"},
       }
   end
   if ownWeapons and #ownWeapons > 0 then
       _weaponBorrowNotified[sourceName] = nil
       return ownWeapons
   end
   -- Try borrowing from another autofarm
   for _, src in ipairs(otherSources) do
       if src.weapons and #src.weapons > 0 then
           if not _weaponBorrowNotified[sourceName] then
               _weaponBorrowNotified[sourceName] = true
               spawnNotification("No weapons in " .. sourceName .. " Autofarm. Borrowing from " .. src.name, "info")
           end
           return src.weapons
       end
   end
   -- Nothing anywhere
   if not _weaponBorrowNotified[sourceName] then
       _weaponBorrowNotified[sourceName] = true
       spawnNotification("No weapons selected for " .. sourceName .. " Autofarm!", "warning")
   end
   return {}
end
