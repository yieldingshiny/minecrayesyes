   local function getSmartBotPathSignature(waypoints)
       local count = waypoints and #waypoints or 0
       if count == 0 then
           return "0"
       end
       local first = waypoints[1].Position
       local mid = waypoints[math.max(1, math.floor((count + 1) / 2))].Position
       local last = waypoints[count].Position
       return table.concat({
           tostring(count),
           tostring(math.floor(first.X / 4)),
           tostring(math.floor(first.Y / 4)),
           tostring(math.floor(first.Z / 4)),
           tostring(math.floor(mid.X / 4)),
           tostring(math.floor(mid.Y / 4)),
           tostring(math.floor(mid.Z / 4)),
           tostring(math.floor(last.X / 4)),
           tostring(math.floor(last.Y / 4)),
           tostring(math.floor(last.Z / 4)),
       }, ":")
   end
   local function computeSmartBotPath(state, rootPos, goalPos, visualFlag, config, extraIgnore)
       local now = tick()
       state.lastPathTime = now
       state.lastGoalPos = goalPos
       local pathSource = "direct"
       local waypoints = tryComputePathWaypoints(rootPos, goalPos, config, extraIgnore)
       if not waypoints then
           local checkpointGoal = getCheckpointAdvanceGoal(rootPos, goalPos, extraIgnore)
           if checkpointGoal then
               waypoints = tryComputePathWaypoints(rootPos, checkpointGoal, config, extraIgnore)
               if waypoints then pathSource = "checkpoint" end
           end
       end
       if not waypoints then
           for _, advanceGoal in ipairs(getIntermediateAdvanceGoals(rootPos, goalPos, extraIgnore)) do
               waypoints = tryComputePathWaypoints(rootPos, advanceGoal, config, extraIgnore)
               if waypoints then
                   pathSource = "intermediate"
                   break
               end
           end
       end
       if waypoints and #waypoints > 0 then
           local refinedWaypoints = {}
           for i = 1, #waypoints do
               local current = waypoints[i]
               if i == 1 then
                   table.insert(refinedWaypoints, {
                       Position = current.Position,
                       Action = current.Action,
                       Exact = current.Action == Enum.PathWaypointAction.Jump,
                   })
               end
               if i < #waypoints then
                   local nextPoint = waypoints[i + 1]
                   local segmentDistance = (nextPoint.Position - current.Position).Magnitude
                   local segmentSpacing = config.pathPointSpacing or config.waypointSpacing or 4
                   local segmentPlanar = Vector3.new(nextPoint.Position.X - current.Position.X, 0, nextPoint.Position.Z - current.Position.Z).Magnitude
                   local segmentRise = nextPoint.Position.Y - current.Position.Y
                   local lowBlocked = not isBotPathRayClear(current.Position + Vector3.new(0, 1.25, 0), nextPoint.Position + Vector3.new(0, 1.25, 0), extraIgnore)
                   local highClear = isBotPathRayClear(current.Position + Vector3.new(0, 4.5, 0), nextPoint.Position + Vector3.new(0, 4.5, 0), extraIgnore)
                   local stairSegment = isBotStairLikeSegment(segmentRise, segmentPlanar, lowBlocked, highClear, nextPoint.Action, config)
                       or isBotStairLikeSegment(segmentRise, segmentPlanar, lowBlocked, highClear, current.Action, config)
                   local segmentShouldProject = math.abs(segmentRise) >= (config.segmentProjectThreshold or 1.25)
                   if segmentRise < -(config.downhillRelaxY or 2) then
                       segmentSpacing = math.min(segmentSpacing, config.downhillPointSpacing or segmentSpacing)
                       segmentShouldProject = true
                   end
                   if stairSegment then
                       table.insert(refinedWaypoints, {
                           Position = nextPoint.Position,
                           Action = nextPoint.Action,
                           Exact = true,
                       })
                   else
                       local steps = math.max(1, math.ceil(segmentDistance / math.max(segmentSpacing, 1)))
                       for step = 1, steps do
                           local t = step / steps
                           local samplePos = current.Position:Lerp(nextPoint.Position, t)
                           if step < steps and segmentShouldProject then
                               local projected = projectGroundBelowPoint(samplePos + Vector3.new(0, 2, 0), extraIgnore)
                               if math.abs(projected.Y - samplePos.Y) <= (config.pathProjectionClamp or 4) then
                                   samplePos = Vector3.new(samplePos.X, projected.Y, samplePos.Z)
                               end
                           end
                           table.insert(refinedWaypoints, {
                               Position = samplePos,
                               Action = step == steps and nextPoint.Action or Enum.PathWaypointAction.Walk,
                               Exact = false,
                           })
                       end
                   end
               end
           end
           local smoothedWaypoints = {}
           for i = 1, #refinedWaypoints do
               local current = refinedWaypoints[i]
               if i == 1 or i == #refinedWaypoints then
                   table.insert(smoothedWaypoints, current)
               else
                   local prev = smoothedWaypoints[#smoothedWaypoints]
                   local nextPoint = refinedWaypoints[i + 1]
                   local prevRise = current.Position.Y - prev.Position.Y
                   local nextRise = nextPoint.Position.Y - current.Position.Y
                   local prevPlanar = Vector3.new(current.Position.X - prev.Position.X, 0, current.Position.Z - prev.Position.Z).Magnitude
                   local nextPlanar = Vector3.new(nextPoint.Position.X - current.Position.X, 0, nextPoint.Position.Z - current.Position.Z).Magnitude
                   local flatEnough = math.abs(prev.Position.Y - current.Position.Y) <= (config.flatPathYTolerance or 0.85)
                       and math.abs(current.Position.Y - nextPoint.Position.Y) <= (config.flatPathYTolerance or 0.85)
                       and math.abs(prev.Position.Y - nextPoint.Position.Y) <= (config.flatPathYTolerance or 0.85)
                  local stairLike = current.Exact == true
                      or isBotStairLikeSegment(prevRise, prevPlanar, false, false, current.Action, config)
                      or isBotStairLikeSegment(nextRise, nextPlanar, false, false, nextPoint.Action, config)
                   local stairOccluded = not isBotPathRayClear(prev.Position + Vector3.new(0, 1.25, 0), nextPoint.Position + Vector3.new(0, 1.25, 0), extraIgnore)
                       and isBotPathRayClear(prev.Position + Vector3.new(0, 4.5, 0), nextPoint.Position + Vector3.new(0, 4.5, 0), extraIgnore)
                   local redundantVisible = flatEnough
                       and not stairLike
                       and not stairOccluded
                       and current.Action ~= Enum.PathWaypointAction.Jump
                       and canBotSeePosition(prev.Position, nextPoint.Position, extraIgnore)
                   if not redundantVisible then
                       table.insert(smoothedWaypoints, current)
                   end
               end
           end
           waypoints = smoothedWaypoints
           state.waypoints = waypoints
           state.waypointIndex = 1
           state.failedPathCount = 0
           state.stuckCount = 0
           state.visualFlag = visualFlag
           if state.debugLastPathSource ~= pathSource and S._botDebug and S._botDebug.push then
               S._botDebug.push(state.ownerName .. " path " .. pathSource .. " (" .. tostring(#waypoints) .. " pts)")
           end
           state.debugLastPathSource = pathSource
           local visualSignature = getSmartBotPathSignature(waypoints)
           if visualSignature ~= state.lastVisualSignature
               or now - (state.lastVisualTime or 0) >= (config.visualRedrawInterval or 0.75) then
               drawPath(waypoints, visualFlag, state.ownerName)
               state.lastVisualSignature = visualSignature
               state.lastVisualTime = now
           end
           return true
       end
       state.failedPathCount = state.failedPathCount + 1
       if state.debugLastPathSource ~= "failed" and S._botDebug and S._botDebug.push then
           S._botDebug.push(state.ownerName .. " path failed")
       end
       state.debugLastPathSource = "failed"
       if not state.waypoints or state.waypointIndex > #state.waypoints then
           state.waypoints = nil
           state.waypointIndex = 1
           state.lastVisualTime = 0
           state.lastVisualSignature = nil
           clearPathVisuals(state.ownerName)
       end
       return false
   end
   local function updateSmartBotProgress(state, root, hum, moveTarget, goalPos, config)
       local now = tick()
       if not state.lastProgressPos then
           state.lastProgressPos = root.Position
           state.lastProgressTime = now
           state.lastGoalDist = (root.Position - goalPos).Magnitude
           state.lastMoveTargetDist = (root.Position - moveTarget).Magnitude
           return
       end
       if now - state.lastProgressTime < config.progressCheckInterval then
           return
       end
       local moved = (root.Position - state.lastProgressPos).Magnitude
       local goalDist = (root.Position - goalPos).Magnitude
       local moveTargetDist = (root.Position - moveTarget).Magnitude
       local goalProgress = state.lastGoalDist and (state.lastGoalDist - goalDist) or 0
       local targetProgress = state.lastMoveTargetDist and (state.lastMoveTargetDist - moveTargetDist) or 0
       local movePlanar = Vector3.new(moveTarget.X - root.Position.X, 0, moveTarget.Z - root.Position.Z).Magnitude
       local planarVelocity = Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z).Magnitude
       local downhillDelta = root.Position.Y - moveTarget.Y
       local uphillDelta = moveTarget.Y - root.Position.Y
       local progressFactor = 1
       local jumpThreshold = config.jumpStuckThreshold or 2
       local hopThreshold = config.hopStuckThreshold or 4
       if downhillDelta >= (config.downhillRelaxY or 2) and movePlanar <= (config.downhillRelaxPlanar or 18) then
           progressFactor = config.downhillProgressFactor or 0.4
           jumpThreshold = jumpThreshold + (config.downhillJumpThresholdBonus or 1)
           hopThreshold = hopThreshold + (config.downhillJumpThresholdBonus or 1)
       elseif not state.stairMode and uphillDelta >= (config.uphillRelaxY or 1.1) and movePlanar <= (config.uphillRelaxPlanar or 18) then
           progressFactor = config.uphillProgressFactor or 0.6
           jumpThreshold = jumpThreshold + (config.uphillJumpThresholdBonus or 1)
           hopThreshold = hopThreshold + (config.uphillJumpThresholdBonus or 1)
       end
       local makingMeasuredProgress = moved >= ((config.progressMinMove or 0.5) * progressFactor)
           or goalProgress >= ((config.goalProgressMin or 0.15) * progressFactor)
           or targetProgress >= ((config.targetProgressMin or 0.25) * progressFactor)
           or planarVelocity >= (config.progressVelocityMin or 2.5)
       if goalDist > config.arrivalDistance and not makingMeasuredProgress then
           state.stuckCount = state.stuckCount + 1
           if state.stuckCount == 1 and S._botDebug and S._botDebug.push then
               S._botDebug.push(state.ownerName .. " low progress near " .. string.format("%.1f", movePlanar))
           end
           if state.stuckCount >= jumpThreshold then
               requestSmartBotJump(state, hum, config)
           end
           if state.stuckCount == math.max(2, jumpThreshold) and state.waypoints and state.waypointIndex < #state.waypoints then
               state.waypointIndex = state.waypointIndex + 1
           elseif state.stuckCount >= hopThreshold then
               local dir = moveTarget - root.Position
               if dir.Magnitude > 1 then
                   local hop = dir.Unit * math.min(dir.Magnitude, config.hopDistance)
                   local hopUp = math.max(config.minHopUp, math.clamp(moveTarget.Y - root.Position.Y, 0, config.hopUp))
                   root.CFrame = CFrame.new(root.Position + hop + Vector3.new(0, hopUp, 0))
                   breakVelocity(root)
                   if S._botDebug and S._botDebug.push then
                       S._botDebug.push(state.ownerName .. " hop recovery")
                   end
               end
               state.stuckCount = 0
               state.waypoints = nil
               state.waypointIndex = 1
               state.lastPathTime = 0
               state.lastMovePos = nil
               state.lastGoalDist = nil
               state.lastMoveTargetDist = nil
           end
       else
           state.stuckCount = 0
       end
       state.lastProgressPos = root.Position
       state.lastProgressTime = now
       state.lastGoalDist = goalDist
       state.lastMoveTargetDist = moveTargetDist
   end
   -- Sub-sub-block: split to stay under Luau 200-local-register limit

   local function getSmartBotMoveTarget(state, rootPos, goalPos, config, extraIgnore)
       if not state.waypoints or state.waypointIndex > #state.waypoints then
           state.stairMode = false
           state.preciseMode = false
           return goalPos
       end
       local currentWaypoint = state.waypoints[state.waypointIndex]
       local nextWaypoint = state.waypoints[state.waypointIndex + 1]
       local stairMode = false
       local preciseMode = false
       if currentWaypoint then
           local currentPlanar = Vector3.new(currentWaypoint.Position.X - rootPos.X, 0, currentWaypoint.Position.Z - rootPos.Z).Magnitude
           local currentRise = currentWaypoint.Position.Y - rootPos.Y
           local lowBlocked = not isBotPathRayClear(rootPos + Vector3.new(0, 1.25, 0), currentWaypoint.Position + Vector3.new(0, 1.25, 0), extraIgnore)
           local highClear = isBotPathRayClear(rootPos + Vector3.new(0, 4.5, 0), currentWaypoint.Position + Vector3.new(0, 4.5, 0), extraIgnore)
           stairMode = currentWaypoint.Exact == true
               or isBotStairLikeSegment(currentRise, currentPlanar, lowBlocked, highClear, currentWaypoint.Action, config)
           if nextWaypoint then
               local nextPlanar = Vector3.new(nextWaypoint.Position.X - currentWaypoint.Position.X, 0, nextWaypoint.Position.Z - currentWaypoint.Position.Z).Magnitude
               local nextRise = nextWaypoint.Position.Y - currentWaypoint.Position.Y
               local nextLowBlocked = not isBotPathRayClear(currentWaypoint.Position + Vector3.new(0, 1.25, 0), nextWaypoint.Position + Vector3.new(0, 1.25, 0), extraIgnore)
               local nextHighClear = isBotPathRayClear(currentWaypoint.Position + Vector3.new(0, 4.5, 0), nextWaypoint.Position + Vector3.new(0, 4.5, 0), extraIgnore)
               stairMode = stairMode
                   or nextWaypoint.Exact == true
                   or isBotStairLikeSegment(nextRise, nextPlanar, nextLowBlocked, nextHighClear, nextWaypoint.Action, config)
               if currentPlanar > 0.5 and nextPlanar > 0.5 then
                   local currentDir = Vector3.new(currentWaypoint.Position.X - rootPos.X, 0, currentWaypoint.Position.Z - rootPos.Z).Unit
                   local nextDir = Vector3.new(nextWaypoint.Position.X - currentWaypoint.Position.X, 0, nextWaypoint.Position.Z - currentWaypoint.Position.Z).Unit
                   local turnDot = currentDir:Dot(nextDir)
                   preciseMode = turnDot <= (config.preciseTurnDotThreshold or 0.55)
                       and currentPlanar <= (config.preciseTurnPlanarThreshold or 7.5)
                       and (currentRise >= (config.uphillRelaxY or 1.1) or nextRise >= (config.uphillRelaxY or 1.1))
                       and lowBlocked
                       and highClear
               end
           end
       end
       state.stairMode = stairMode
       state.preciseMode = preciseMode
       local exactMode = stairMode or preciseMode
       local reachDistance = exactMode and (config.preciseWaypointReachDistance or config.stairWaypointReachDistance or math.min(config.waypointReachDistance, 2.25)) or config.waypointReachDistance
       while state.waypointIndex <= #state.waypoints do
           local waypointPos = state.waypoints[state.waypointIndex].Position
           local planarDiff = Vector3.new(waypointPos.X - rootPos.X, 0, waypointPos.Z - rootPos.Z).Magnitude
           local verticalDiff = math.abs(waypointPos.Y - rootPos.Y)
           local reached = (rootPos - waypointPos).Magnitude <= reachDistance
           if exactMode then
               reached = planarDiff <= reachDistance and verticalDiff <= (config.exactWaypointVerticalTolerance or 0.75)
           end
           if not reached then
               break
           end
           state.waypointIndex = state.waypointIndex + 1
       end
       while (not exactMode) and state.waypointIndex < #state.waypoints do
           local waypointPos = state.waypoints[state.waypointIndex].Position
           local nextWaypointPos = state.waypoints[state.waypointIndex + 1].Position
           local isBacktracking = (waypointPos - goalPos).Magnitude > (rootPos - goalPos).Magnitude + config.backwardTolerance
           if isBacktracking and canBotSeePosition(rootPos, nextWaypointPos, extraIgnore) then
               state.waypointIndex = state.waypointIndex + 1
           else
               break
           end
       end
       if state.waypointIndex > #state.waypoints then
           return goalPos
       end
       local bestIndex = state.waypointIndex
       local lookAhead = exactMode and (config.stairLookAheadWaypoints or 0) or config.lookAheadWaypoints
       local furthestIndex = math.min(#state.waypoints, state.waypointIndex + lookAhead)
       for idx = state.waypointIndex + 1, furthestIndex do
           if canBotSeePosition(rootPos, state.waypoints[idx].Position, extraIgnore) then
               bestIndex = idx
           else
               break
           end
       end
       state.waypointIndex = bestIndex
       return state.waypoints[bestIndex].Position
   end
   local function updateSmartBotState(state, root, hum, targetRef, goalPos, visualFlag, config, extraIgnore)
       if not root or not hum or hum.Health <= 0 or not goalPos then
           resetSmartBotState(state)
           return false
       end
       local now = tick()
       local targetChanged = state.targetRef ~= targetRef
       local goalDist = (root.Position - goalPos).Magnitude
       local closeTracking = goalDist <= (config.closeGoalTrackingDistance or 0)
       local goalMoveThreshold = closeTracking and (config.closeRepathGoalMoveThreshold or config.repathGoalMoveThreshold) or config.repathGoalMoveThreshold
       local goalMoved = (not state.lastGoalPos) or ((state.lastGoalPos - goalPos).Magnitude >= goalMoveThreshold)
       local directVisible = canBotSeePosition(root.Position, goalPos, extraIgnore)
       local lowDirectClear = isBotPathRayClear(root.Position + Vector3.new(0, 1.25, 0), goalPos + Vector3.new(0, 1.25, 0), extraIgnore)
       local midDirectClear = isBotPathRayClear(root.Position + Vector3.new(0, 2.75, 0), goalPos + Vector3.new(0, 2.75, 0), extraIgnore)
       local directWalkClear = lowDirectClear
           or ((goalPos.Y - root.Position.Y) >= (config.stairRiseThreshold or 0.45) and midDirectClear)
       local function updateDebugSnapshot(modeName)
           if S._botDebug then
               S._botDebug.snapshot = {
                   mode = modeName,
                   goalDist = goalDist,
                   closeTracking = closeTracking,
               }
           end
           if state.debugLastMode ~= modeName and S._botDebug and S._botDebug.push then
               S._botDebug.push(state.ownerName .. " mode " .. modeName)
           end
           state.debugLastMode = modeName
       end
       local stairDirectBlock = state.stairMode or state.preciseMode
       if (not stairDirectBlock) and state.waypoints and state.waypointIndex <= #state.waypoints then
           local activeWaypoint = state.waypoints[state.waypointIndex]
           local nextWaypoint = state.waypoints[state.waypointIndex + 1]
           if activeWaypoint then
               local activePlanar = Vector3.new(activeWaypoint.Position.X - root.Position.X, 0, activeWaypoint.Position.Z - root.Position.Z).Magnitude
               local activeRise = activeWaypoint.Position.Y - root.Position.Y
               local activeLowBlocked = not isBotPathRayClear(root.Position + Vector3.new(0, 1.25, 0), activeWaypoint.Position + Vector3.new(0, 1.25, 0), extraIgnore)
               local activeHighClear = isBotPathRayClear(root.Position + Vector3.new(0, 4.5, 0), activeWaypoint.Position + Vector3.new(0, 4.5, 0), extraIgnore)
               stairDirectBlock = activeWaypoint.Exact == true
                   or isBotStairLikeSegment(activeRise, activePlanar, activeLowBlocked, activeHighClear, activeWaypoint.Action, config)
               if (not stairDirectBlock) and nextWaypoint and activePlanar > 0.5 then
                   local nextPlanar = Vector3.new(nextWaypoint.Position.X - activeWaypoint.Position.X, 0, nextWaypoint.Position.Z - activeWaypoint.Position.Z).Magnitude
                   local nextRise = nextWaypoint.Position.Y - activeWaypoint.Position.Y
                   if nextPlanar > 0.5 then
                       local activeDir = Vector3.new(activeWaypoint.Position.X - root.Position.X, 0, activeWaypoint.Position.Z - root.Position.Z).Unit
                       local nextDir = Vector3.new(nextWaypoint.Position.X - activeWaypoint.Position.X, 0, nextWaypoint.Position.Z - activeWaypoint.Position.Z).Unit
                       stairDirectBlock = activeDir:Dot(nextDir) <= (config.preciseTurnDotThreshold or 0.55)
                           and activePlanar <= (config.preciseTurnPlanarThreshold or 7.5)
                           and (activeRise >= (config.uphillRelaxY or 1.1) or nextRise >= (config.uphillRelaxY or 1.1))
                   end
               end
