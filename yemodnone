   local function doReorder(notifyRow, notifyLabel)
       if S.isReordering then return end
       S.isReordering = true
       S.reorderCancelRequested = false
       local originalText = notifyLabel and notifyLabel.Text or "Start AutoDuping"
       task.spawn(function()
           local cancelled = false
           local amount = math.max(1, tonumber(S.weaponReorderAmount) or 1)
           for i = 1, amount do
               if S.reorderCancelRequested then
                   cancelled = true
                   break
               end
               if notifyLabel then notifyLabel.Text = i .. "/" .. amount end
               local playerGui = _Players.LocalPlayer:WaitForChild("PlayerGui")
               local st = playerGui:FindFirstChild("PermGui") and playerGui.PermGui:FindFirstChild("ShopGui") and playerGui.PermGui.ShopGui:FindFirstChild("ReorderButton")
               if st and st.Visible then
                   local x, y = getCenter(st)
                   _VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
                   task.wait(0.05)
                   _VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
                   task.wait(0.2)
                   _VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
                   task.wait(0.05)
                   _VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
               else
                   local shopGui = playerGui:FindFirstChild("PermGui") and playerGui.PermGui:FindFirstChild("ShopGui")
                   local shopBtn = shopGui and shopGui:FindFirstChild("ShopButton")
                   local reorderBtn = shopGui and shopGui:FindFirstChild("ReorderButton")
                   if shopBtn then
                       local x2, y2 = getCenter(shopBtn)
                       _VirtualInputManager:SendMouseButtonEvent(x2, y2, 0, true, game, 1)
                       task.wait(0.05)
                       _VirtualInputManager:SendMouseButtonEvent(x2, y2, 0, false, game, 1)
                       task.wait(1)
                   end
                   if reorderBtn then
                       local x, y = getCenter(reorderBtn)
                       _VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
                       task.wait(0.05)
                       _VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
                   end
               end
               if S.reorderCancelRequested then
                   cancelled = true
                   break
               end
               if i < amount then
                   local remaining = math.max(0, tonumber(S.dupeCooldown) or 0)
                   while remaining > 0 do
                       if S.reorderCancelRequested then
                           cancelled = true
                           break
                       end
                       local step = math.min(0.05, remaining)
                       task.wait(step)
                       remaining = remaining - step
                   end
                   if cancelled then break end
               end
           end
           if notifyLabel then notifyLabel.Text = originalText end
           S.isReordering = false
           local shouldNotifyCancelled = S.reorderCancelRequested or cancelled
           S.reorderCancelRequested = false
           if shouldNotifyCancelled then
               spawnNotification("AutoDuping cancelled.", "warning")
           end
       end)
   end
