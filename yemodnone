       local directMoveAllowed = directVisible
           and directWalkClear
           and goalDist <= config.directMoveDistance
           and math.abs(goalPos.Y - root.Position.Y) <= (config.directMoveMaxYDelta or math.huge)
           and not stairDirectBlock
       if closeTracking and directVisible and directWalkClear and not stairDirectBlock and goalDist > config.arrivalDistance then
           updateDebugSnapshot("close_chase")
           state.targetRef = targetRef
           state.lastGoalPos = goalPos
           state.failedPathCount = 0
           issueSmartBotMove(state, hum, goalPos, config)
           local goalPlanarDelta = Vector3.new(goalPos.X - root.Position.X, 0, goalPos.Z - root.Position.Z).Magnitude
           if goalPlanarDelta <= (config.jumpProximityDistance or 5)
               and goalPos.Y - root.Position.Y > config.jumpHeightDelta then
               requestSmartBotJump(state, hum, config)
           end
           updateSmartBotProgress(state, root, hum, goalPos, goalPos, config)
           return false
       end
       if goalDist <= config.arrivalDistance or directMoveAllowed then
           updateDebugSnapshot(goalDist <= config.arrivalDistance and "arrived" or "direct")
           state.targetRef = targetRef
           state.lastGoalPos = goalPos
           state.failedPathCount = 0
           if goalDist <= config.arrivalDistance then
               state.waypoints = nil
               state.waypointIndex = 1
               state.lastVisualTime = 0
               state.lastVisualSignature = nil
               clearPathVisuals(state.ownerName)
           end
           issueSmartBotMove(state, hum, goalPos, config)
           local goalPlanarDelta = Vector3.new(goalPos.X - root.Position.X, 0, goalPos.Z - root.Position.Z).Magnitude
           if goalPlanarDelta <= (config.jumpProximityDistance or 5) and goalPos.Y - root.Position.Y > config.jumpHeightDelta then
               requestSmartBotJump(state, hum, config)
           end
           updateSmartBotProgress(state, root, hum, goalPos, goalPos, config)
           return goalDist <= config.arrivalDistance
       end
       local dropCandidate = nil
       if state.waypoints and state.waypointIndex <= #state.waypoints then
           for idx = state.waypointIndex, math.min(#state.waypoints, state.waypointIndex + 5) do
               local candidatePos = state.waypoints[idx].Position
               local candidatePlanar = Vector3.new(candidatePos.X - root.Position.X, 0, candidatePos.Z - root.Position.Z)
               local candidateDrop = root.Position.Y - candidatePos.Y
               if candidateDrop >= (config.dropMinHeight or 3.5)
                   and candidateDrop <= (config.dropMaxHeight or 18)
                   and candidatePlanar.Magnitude <= (config.dropSearchDistance or 22) then
                   dropCandidate = candidatePos
                   break
               end
           end
       end
       if not dropCandidate then
           local goalPlanarVec = Vector3.new(goalPos.X - root.Position.X, 0, goalPos.Z - root.Position.Z)
           local goalDrop = root.Position.Y - goalPos.Y
           if goalDrop >= (config.dropMinHeight or 3.5)
               and goalDrop <= (config.dropMaxHeight or 18)
               and goalPlanarVec.Magnitude <= (config.dropSearchDistance or 22) then
               dropCandidate = goalPos
           end
       end
       if dropCandidate then
           local dropVector = Vector3.new(dropCandidate.X - root.Position.X, 0, dropCandidate.Z - root.Position.Z)
           if dropVector.Magnitude > 1 then
               local approachStep = math.min(config.dropApproachDistance or 4.75, math.max(1.5, dropVector.Magnitude - 1))
               local approachPos = root.Position + dropVector.Unit * approachStep
               local projectedApproach = projectGroundBelowPoint(approachPos + Vector3.new(0, 2, 0), extraIgnore)
               local approachPlanar = Vector3.new(projectedApproach.X - root.Position.X, 0, projectedApproach.Z - root.Position.Z).Magnitude
               local lowBlocked = not isBotPathRayClear(root.Position + Vector3.new(0, 1.25, 0), projectedApproach + Vector3.new(0, 1.25, 0), extraIgnore)
               local highClear = isBotPathRayClear(root.Position + Vector3.new(0, 4.5, 0), projectedApproach + Vector3.new(0, 4.5, 0), extraIgnore)
               local landingVisible = canBotSeePosition(projectedApproach, dropCandidate, extraIgnore)
               if approachPlanar > 1
                   and landingVisible
                   and (highClear or canBotSeePosition(root.Position, projectedApproach, extraIgnore)) then
                   state.targetRef = targetRef
                   state.lastGoalPos = goalPos
                   state.failedPathCount = 0
                   issueSmartBotMove(state, hum, projectedApproach, config)
                   if lowBlocked and highClear then
                       requestSmartBotJump(state, hum, config)
                   end
                   updateSmartBotProgress(state, root, hum, projectedApproach, goalPos, config)
                   return false
               end
           end
       end
       local shouldRepath = targetChanged
           or not state.waypoints
           or state.waypointIndex > #state.waypoints
       if closeTracking then
           shouldRepath = shouldRepath
               or (goalMoved and now - state.lastPathTime >= (config.closeRepathInterval or config.repathInterval or 0.2))
       else
           shouldRepath = shouldRepath
               or goalMoved
               or now - state.lastPathTime >= config.repathInterval
       end
       if shouldRepath then
           computeSmartBotPath(state, root.Position, goalPos, visualFlag, config, extraIgnore)
       end
       if not state.waypoints or state.waypointIndex > #state.waypoints then
           updateDebugSnapshot("no_path")
           state.targetRef = targetRef
           state.lastGoalPos = goalPos
           state.lastMovePos = nil
           state.lastMoveTime = 0
           state.lastProgressPos = root.Position
           state.lastProgressTime = now
           state.lastGoalDist = goalDist
           state.lastMoveTargetDist = nil
           return false
       end
       state.targetRef = targetRef
       state.lastGoalPos = goalPos
       local moveTarget = getSmartBotMoveTarget(state, root.Position, goalPos, config, extraIgnore)
       local stairMode = state.stairMode
       local exactMode = stairMode or state.preciseMode
       updateDebugSnapshot(exactMode and "exact" or "path")
       local issuedMoveTarget = moveTarget
       if exactMode then
           local exactVector = moveTarget - root.Position
           local exactStep = config.exactMoveStep or 1.35
           if exactVector.Magnitude > exactStep then
               issuedMoveTarget = root.Position + exactVector.Unit * exactStep
           end
       end
       if state.waypoints and state.waypointIndex <= #state.waypoints then
           local waypoint = state.waypoints[state.waypointIndex]
           if waypoint.Action == Enum.PathWaypointAction.Jump then
               requestSmartBotJump(state, hum, config)
           end
           local movePlanar = Vector3.new(issuedMoveTarget.X - root.Position.X, 0, issuedMoveTarget.Z - root.Position.Z).Magnitude
           local moveRise = issuedMoveTarget.Y - root.Position.Y
           local lowBlockedMove = not isBotPathRayClear(root.Position + Vector3.new(0, 1.25, 0), issuedMoveTarget + Vector3.new(0, 1.25, 0), extraIgnore)
           local highClearMove = isBotPathRayClear(root.Position + Vector3.new(0, 4.5, 0), issuedMoveTarget + Vector3.new(0, 4.5, 0), extraIgnore)
           if exactMode
               and movePlanar <= (config.stairJumpProximityDistance or config.jumpProximityDistance or 5)
               and ((moveRise >= (config.stairRiseThreshold or 0.45) and highClearMove) or lowBlockedMove)
               and (highClearMove or moveRise >= (config.stairRiseThreshold or 0.45) or state.stuckCount > 0) then
               requestSmartBotJump(state, hum, config)
           elseif (not exactMode)
               and movePlanar <= (config.jumpProximityDistance or 5)
               and lowBlockedMove
               and highClearMove
               and moveRise >= -1 then
               requestSmartBotJump(state, hum, config)
           end
           local nextWaypoint = state.waypoints[state.waypointIndex + 1]
           if nextWaypoint then
               local nextRise = nextWaypoint.Position.Y - root.Position.Y
               local nextPlanar = Vector3.new(nextWaypoint.Position.X - root.Position.X, 0, nextWaypoint.Position.Z - root.Position.Z).Magnitude
               if nextPlanar <= (((exactMode and config.stairJumpProximityDistance) or config.jumpProximityDistance) or 5)
                   and nextRise > config.jumpHeightDelta
                   and not canBotSeePosition(root.Position, nextWaypoint.Position, extraIgnore) then
                   requestSmartBotJump(state, hum, config)
               end
           end
       else
           local goalPlanar = Vector3.new(goalPos.X - root.Position.X, 0, goalPos.Z - root.Position.Z).Magnitude
           if goalPlanar <= (config.jumpProximityDistance or 5)
               and goalPos.Y - root.Position.Y > config.jumpHeightDelta
               and not directVisible then
               requestSmartBotJump(state, hum, config)
           end
       end
       issueSmartBotMove(state, hum, issuedMoveTarget, config)
       updateSmartBotProgress(state, root, hum, issuedMoveTarget, goalPos, config)
       return false
   end
   local function getGeneralBotGoal(rootPos, targetGeneral, targetPart)
       if not targetPart then return nil end
       local targetBase = projectGroundBelowPoint(targetPart.Position, {targetGeneral})
       local candidates = {targetBase}
       local baseAngles = {0, 45, -45, 90, -90, 135, -135, 180}
       local toRoot = Vector3.new(rootPos.X - targetBase.X, 0, rootPos.Z - targetBase.Z)
       local baseAngle = toRoot.Magnitude > 0.1 and math.atan2(toRoot.Z, toRoot.X) or 0
      for _, radius in ipairs({2, 3.5, 5, 7, 9}) do
          for _, angleDeg in ipairs(baseAngles) do
              local angle = baseAngle + math.rad(angleDeg)
              local offset = Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
              local projected = projectGroundBelowPoint(targetBase + offset, {targetGeneral})
              table.insert(candidates, projected)
           end
       end
       local bestCandidate = targetBase
       local bestScore = math.huge
      for _, candidate in ipairs(candidates) do
          local heightPenalty = math.abs(candidate.Y - targetBase.Y) * 10
          local distPenalty = (candidate - rootPos).Magnitude
          local offsetPenalty = (candidate - targetBase).Magnitude * 4
          local targetVisible = canBotSeePosition(candidate, targetPart.Position, {targetGeneral}) and 0 or 400
          local roofPenalty = candidate.Y > targetPart.Position.Y + 3 and 250 or 0
          local score = distPenalty + heightPenalty + offsetPenalty + targetVisible + roofPenalty
          if score < bestScore then
              bestScore = score
              bestCandidate = candidate
           end
       end
       return Vector3.new(bestCandidate.X, bestCandidate.Y, bestCandidate.Z)
   end
