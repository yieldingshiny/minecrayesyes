local function ensureEspHighlight(parent, highlightName, adornee, color, fillTransparency)
   local highlight = parent:FindFirstChild(highlightName)
   if highlight and not highlight:IsA("Highlight") then
       pcall(function() highlight:Destroy() end)
       highlight = nil
   end
   if not highlight then
       highlight = Instance.new("Highlight")
       highlight.Name = highlightName
       highlight.Parent = parent
   end
   highlight.Adornee = adornee
   highlight.FillColor = color
   highlight.FillTransparency = fillTransparency or 0.5
   highlight.OutlineColor = color
   highlight.OutlineTransparency = 0
   return highlight
end
local function destroyTrackedEsp(espData)
   if not espData then return end
   pcall(function() if espData.highlight then espData.highlight:Destroy() end end)
   pcall(function() if espData.billboard then espData.billboard:Destroy() end end)
end
