                           end
                       end
                       if npcData then
                           currentNpcTarget = npcData.model
                           S.npcIsFollowing = true
                           ensureHoldConnection()
                           -- Move to the NPC (tween or teleport based on method)
                           if S.autofarmNpcEnabled and isTargetAlive(currentNpcTarget) then
                               local targetPos = npcData.part.Position - Vector3.new(0, 5, 0)
                               if S.npcFarmMethod == "Tween" then
                                   -- Tween smoothly to the NPC
                                   local startCF = npcHoldCF or root.CFrame
                                   local dist = (startCF.Position - targetPos).Magnitude
                                   local tweenTime = math.clamp(dist / S.npcTweenSpeed, 0.3, 6)
                                   npcTweening = true
                                   local elapsed = 0
                                   local startPos = startCF.Position
                                   while elapsed < tweenTime and S.autofarmNpcEnabled and currentNpcTarget and isTargetAlive(currentNpcTarget) do
                                       elapsed = elapsed + task.wait()
                                       local alpha = math.min(elapsed / tweenTime, 1)
                                       local tweenedPos = startPos:Lerp(targetPos, alpha)
                                       npcHoldCF = CFrame.new(tweenedPos) * CFrame.Angles(math.pi / 2, 0, 0)
                                   end
                                   npcTweening = false
                               else
                                   -- Teleport instantly
                                   npcHoldCF = CFrame.new(targetPos) * CFrame.Angles(math.pi / 2, 0, 0)
                               end
                               -- Now the hold connection will auto-follow the target (NPC or General)
                           end
                       end
                   end
               else
                   -- Player died: fully reset everything so it starts fresh on respawn
                   if npcSetupDone or currentNpcTarget or npcHoldCF then
                       cleanupNpcFarm()
                       npcSetupDone = false
                       npcTweening = false
                       if S.autoInvisNpcEnabled and S._invisEnabled then disableInvis() end
                   end
               end
           else
               cleanupNpcFarm()
               npcSetupDone = false
           end
           task.wait(0.3)
       end
   end)
   -- ======= EGG AUTOFARM MAIN LOOP ======= --
