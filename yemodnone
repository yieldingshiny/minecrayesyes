   local function buildBotRaycastParams(extraIgnore)
       local char = _Players.LocalPlayer.Character
       local extra1 = extraIgnore and extraIgnore[1] or nil
       local extra2 = extraIgnore and extraIgnore[2] or nil
       local unbreakable = workspace:FindFirstChild("Unbreakable")
       if _botRaycastCache.params
           and _botRaycastCache.char == char
           and _botRaycastCache.extra1 == extra1
           and _botRaycastCache.extra2 == extra2
           and _botRaycastCache.unbreakable == unbreakable then
           return _botRaycastCache.params
       end
       local ignoreList = {}
       if char then table.insert(ignoreList, char) end
       if trailFolder then table.insert(ignoreList, trailFolder) end
       if pathVisualsFolder then table.insert(ignoreList, pathVisualsFolder) end
       if unbreakable then
           local projectiles = unbreakable:FindFirstChild("Projectiles")
           if projectiles then table.insert(ignoreList, projectiles) end
           local effects = unbreakable:FindFirstChild("Effects")
           if effects then table.insert(ignoreList, effects) end
       end
       if extraIgnore then
           for _, inst in ipairs(extraIgnore) do
               if inst then
                   table.insert(ignoreList, inst)
               end
           end
       end
       local params = RaycastParams.new()
       params.FilterType = Enum.RaycastFilterType.Blacklist
       params.FilterDescendantsInstances = ignoreList
       params.IgnoreWater = true
       _botRaycastCache.char = char
       _botRaycastCache.extra1 = extra1
       _botRaycastCache.extra2 = extra2
       _botRaycastCache.unbreakable = unbreakable
       _botRaycastCache.params = params
       return params
   end
   local function isBotStairLikeSegment(rise, planar, lowBlocked, highClear, action, config)
       if action == Enum.PathWaypointAction.Jump then
           return true
       end
       local absRise = math.abs(rise or 0)
       local maxPlanar = math.max(planar or 0, 0.01)
       local slopeRatio = absRise / maxPlanar
       if lowBlocked and highClear and maxPlanar <= ((config.stairPlanarThreshold or 6.5) * 1.2) then
           return true
       end
       return absRise >= (config.stairRiseThreshold or 0.8)
           and maxPlanar <= (config.stairPlanarThreshold or 6.5)
           and slopeRatio >= (config.stairSlopeRatio or 0.22)
   end
   local function isBotPathRayClear(fromPos, toPos, extraIgnore)
       local direction = toPos - fromPos
       if direction.Magnitude <= 0.01 then return true end
       local result = workspace:Raycast(fromPos, direction, buildBotRaycastParams(extraIgnore))
       return result == nil
   end
   local function canBotSeePosition(fromPos, toPos, extraIgnore)
       local fromPoints = {
           fromPos + Vector3.new(0, 1, 0),
           fromPos + Vector3.new(0, 2.5, 0),
           fromPos + Vector3.new(0, 4, 0),
       }
       local toPoints = {
           toPos + Vector3.new(0, 1, 0),
           toPos + Vector3.new(0, 2.5, 0),
           toPos + Vector3.new(0, 4, 0),
       }
       local clearCount = 0
       local lowClear = false
       local midClear = false
       for i = 1, #fromPoints do
           local clear = isBotPathRayClear(fromPoints[i], toPoints[i], extraIgnore)
           if clear then
               clearCount = clearCount + 1
               if i == 1 then lowClear = true end
               if i == 2 then midClear = true end
           end
       end
       return (lowClear and midClear) or clearCount == #fromPoints
   end
