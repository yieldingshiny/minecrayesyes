local function breakVelocity(root)
   pcall(function() root.Velocity = Vector3.new(0, 0, 0) end)
   pcall(function() root.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end)
   pcall(function() root.AssemblyAngularVelocity = Vector3.new(0, 0, 0) end)
end
local function teleportToCharacter(targetCharacter)
   local playerRoot = _Players.LocalPlayer.Character and _Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
   if not playerRoot then return false end
   local targetPart = nil
   if targetCharacter.PrimaryPart and targetCharacter.PrimaryPart:IsA("BasePart") then
       targetPart = targetCharacter.PrimaryPart
   else
       for _, partName in ipairs({"HumanoidRootPart", "Torso", "LowerTorso", "UpperTorso", "Head"}) do
           local foundPart = targetCharacter:FindFirstChild(partName)
           if foundPart and foundPart:IsA("BasePart") then
               targetPart = foundPart
               break
           end
       end
       if not targetPart then
           for _, child in pairs(targetCharacter:GetDescendants()) do
               if child:IsA("BasePart") then
                   targetPart = child
                   break
               end
           end
       end
   end
   if not targetPart then return false end
   local pos = targetPart.CFrame
   playerRoot.CFrame = CFrame.new(pos.X, pos.Y + 3, pos.Z, select(4, playerRoot.CFrame:components()))
   breakVelocity(playerRoot)
   return true
end
