-- Player ESP loop (highlights + usernames + HP above heads, updates on join/die)
task.spawn(function()
   local function getPlayerTeamName(player)
       local charName = player.Name
       local unbreakable = workspace:FindFirstChild("Unbreakable")
       local characters = unbreakable and unbreakable:FindFirstChild("Characters")
       if not characters then return "lobby" end
       local orcTeam = characters:FindFirstChild("Orc")
       local humanTeam = characters:FindFirstChild("Human")
       if orcTeam and orcTeam:FindFirstChild(charName) then return "orc" end
       if humanTeam and humanTeam:FindFirstChild(charName) then return "human" end
       return "lobby"
   end
   local function getPlayerHighlightColor(player, teamName)
       local staffData = S._staffCache[player.UserId]
       if staffData then
           return Color3.fromRGB(255, 200, 50)
       end
       if teamName == "orc" then
           local color = Color3.fromRGB(196, 40, 28)
           pcall(function()
               if player.Team then color = player.TeamColor.Color end
           end)
           return color
       elseif teamName == "human" then
           local color = Color3.fromRGB(13, 105, 172)
           pcall(function()
               if player.Team then color = player.TeamColor.Color end
           end)
           return color
       end
       return Color3.new(1, 1, 1)
   end
   local function applyPlayerEsp(player)
       if player == _Players.LocalPlayer then return end
       local char = player.Character
       if not char then return end
       local head = char:FindFirstChild("Head")
       local humanoid = char:FindFirstChildOfClass("Humanoid")
       if not head or not humanoid then return end
       local existing = S.activePlayerEsp[player]
       local existingMatchesCharacter = existing
           and existing.character == char
           and existing.head == head
           and existing.highlight
           and existing.highlight.Parent == char
           and existing.billboard
           and existing.billboard.Parent == char
           and existing.billboard.Adornee == head
           and existing.nameLabel
           and existing.nameLabel.Parent == existing.billboard
           and existing.hpLabel
           and existing.hpLabel.Parent == existing.billboard
       local teamName = getPlayerTeamName(player)
       local color = getPlayerHighlightColor(player, teamName)
       local staffData = S._staffCache[player.UserId]
       local displayColor = staffData and Color3.fromRGB(255, 200, 50) or color
       if existingMatchesCharacter then
           existing.highlight.FillColor = color
           existing.highlight.OutlineColor = color
           if staffData then
               existing.nameLabel.Text = player.Name .. "\n[" .. staffData.roleName .. "]"
           else
               existing.nameLabel.Text = player.Name
           end
           existing.nameLabel.TextColor3 = displayColor
           existing.hpLabel.Text = formatEspHpText(humanoid)
           existing.hpLabel.TextColor3 = displayColor
           existing.teamName = teamName
           return
       end
       if existing then
           destroyTrackedEsp(existing)
       end
       local legacyBill = head:FindFirstChild("PlayerESP_Billboard")
       if legacyBill and legacyBill:IsA("BillboardGui") then
           pcall(function() legacyBill:Destroy() end)
       end
       local highlight = ensureEspHighlight(char, "PlayerESP_Highlight", char, color, 0.5)
       local bill, nameLabel, hpLabel = ensureEspBillboard(char, "PlayerESP_Billboard", head, 13, 12)
       if staffData then
           nameLabel.Text = player.Name .. "\n[" .. staffData.roleName .. "]"
       else
           nameLabel.Text = player.Name
       end
       nameLabel.TextColor3 = displayColor
       hpLabel.Text = formatEspHpText(humanoid)
       hpLabel.TextColor3 = displayColor
       S.activePlayerEsp[player] = {
           highlight = highlight,
           billboard = bill,
           nameLabel = nameLabel,
           hpLabel = hpLabel,
           teamName = teamName,
           character = char,
           head = head,
       }
   end
   while true do
       if S.playerEspEnabled then
           for _, player in pairs(_Players:GetPlayers()) do
               pcall(function() applyPlayerEsp(player) end)
           end
           for player, espData in pairs(S.activePlayerEsp) do
               local valid = false
               pcall(function()
                   local currentChar = player and player.Character
                   local currentHead = currentChar and currentChar:FindFirstChild("Head")
                   if player and player.Parent and currentChar and currentHead then
                       valid = espData.character == currentChar
                           and espData.head == currentHead
                           and espData.highlight
                           and espData.highlight.Parent == currentChar
                           and espData.billboard
                           and espData.billboard.Parent == currentChar
                           and espData.billboard.Adornee == currentHead
                           and espData.nameLabel
                           and espData.nameLabel.Parent == espData.billboard
                           and espData.hpLabel
                           and espData.hpLabel.Parent == espData.billboard
                   end
               end)
               if not valid then
                   destroyTrackedEsp(espData)
                   S.activePlayerEsp[player] = nil
               end
           end
       end
       task.wait(1)
   end
end)
