local function playHubFeedbackStarFall()
    if not hubWrapper.Visible then return end
    local layer = hubMain:FindFirstChild("StarFallLayer")
    if not layer then return end
    local w = layer.AbsoluteSize.X
    local h = layer.AbsoluteSize.Y
    if w < 40 then w = 460 end
    if h < 40 then h = 380 end
    local palette = {
        Color3.fromRGB(255, 255, 255),
        Color3.fromRGB(235, 242, 255),
        Color3.fromRGB(200, 230, 255),
        Color3.fromRGB(120, 200, 255),
        Color3.fromRGB(60, 170, 255),
        Color3.fromRGB(0, 150, 255),
    }
    local n = 22
    for i = 1, n do
        task.delay((i - 1) * 0.03, function()
            if not layer.Parent then return end
            local star = Instance.new("TextLabel")
            star.BackgroundTransparency = 1
            star.Text = "★"
            star.Font = Enum.Font.GothamBold
            star.TextSize = math.random(14, 22)
            star.TextColor3 = palette[math.random(1, #palette)]
            star.TextStrokeTransparency = 0.65
            star.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
            star.Size = UDim2.new(0, 26, 0, 26)
            star.AnchorPoint = Vector2.new(0.5, 0.5)
            star.Active = false
            star.ZIndex = 23
            local xOff = math.random(10, math.max(11, w - 10))
            -- Start below tab header row (~65px) so stars are not needed to be covered by a mask
            star.Position = UDim2.new(0, xOff, 0, math.random(68, 110))
            star.Rotation = math.random(0, 360)
            star.Parent = layer
            local fallTo = h + 45
            local dur = 1.2 + math.random() * 0.55
            local spin = (math.random(0, 1) == 1 and 1 or -1) * math.random(520, 1180)
            _TweenService:Create(star, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                Position = UDim2.new(0, xOff + math.random(-16, 16), 0, fallTo),
                Rotation = star.Rotation + spin,
                TextTransparency = 0.55,
            }):Play()
            game.Debris:AddItem(star, dur + 0.45)
        end)
    end
end
