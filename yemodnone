spawnNotification = function(message, notifType)
   if not S.notificationsEnabled then return end
   notifType = notifType or "info"
   message = message or ("Press " .. guiToggleKeyName .. " to hide GUI")
   local typeConfig = _NOTIF_TYPES[notifType] or _NOTIF_TYPES.info
   local notifGui = Instance.new("ScreenGui")
   notifGui.Name = "InfinitesHubNotif"
   notifGui.ResetOnSpawn = false
   notifGui.IgnoreGuiInset = true
   notifGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
   local ok = pcall(function() notifGui.Parent = _CoreGui end)
   if not ok then notifGui.Parent = _Players.LocalPlayer:WaitForChild("PlayerGui") end
   -- Main container
   local notifContainer = Instance.new("Frame")
   notifContainer.Size = UDim2.new(0, _NOTIF_WIDTH, 0, _NOTIF_HEIGHT)
   notifContainer.AnchorPoint = Vector2.new(1, 1)
   notifContainer.BackgroundColor3 = Color3.fromRGB(25, 28, 35)
   notifContainer.BackgroundTransparency = 1
   notifContainer.BorderSizePixel = 0
   notifContainer.ClipsDescendants = true
   notifContainer.Parent = notifGui
   Instance.new("UICorner", notifContainer).CornerRadius = UDim.new(0, 10)
   local stroke = Instance.new("UIStroke")
   stroke.Color = Color3.fromRGB(50, 55, 65)
   stroke.Transparency = 1
   stroke.Parent = notifContainer
   -- Register and position (start 25px above target for drop-in)
   local thisEntry = {container = notifContainer, gui = notifGui}
   table.insert(_activeNotifications, thisEntry)
   local startY = -_NOTIF_BOTTOM_MARGIN - 25
   notifContainer.Position = UDim2.new(1, -_NOTIF_RIGHT_MARGIN, 1, startY)
   _repositionNotifications()
   -- Background circle (colored per type, faded) with neon glow stroke
   local circleBg = Instance.new("ImageLabel")
   circleBg.Size = UDim2.new(0, 48, 0, 48)
   circleBg.Position = UDim2.new(0, 12, 0.5, -24)
   circleBg.BackgroundTransparency = 1
   circleBg.BorderSizePixel = 0
   circleBg.Image = _NOTIF_CIRCLE_BG
   circleBg.ImageColor3 = typeConfig.color
   circleBg.ImageTransparency = 1
   circleBg.ScaleType = Enum.ScaleType.Fit
   circleBg.ZIndex = 2
   circleBg.Parent = notifContainer
   Instance.new("UICorner", circleBg).CornerRadius = UDim.new(1, 0)
   -- Neon glow ring around circle
   local circleGlow = Instance.new("UIStroke")
   circleGlow.Color = typeConfig.color
   circleGlow.Thickness = 2
   circleGlow.Transparency = 1
   circleGlow.Parent = circleBg
   -- Icon image (centered inside circle, colored to match type)
   local iconImage = Instance.new("ImageLabel")
   iconImage.Size = UDim2.new(0, 22, 0, 22)
   iconImage.Position = UDim2.new(0.5, -11, 0.5, -11)
   iconImage.BackgroundTransparency = 1
   iconImage.BorderSizePixel = 0
   iconImage.Image = typeConfig.iconId
   iconImage.ImageColor3 = typeConfig.iconColor
   iconImage.ImageTransparency = 1
   iconImage.ScaleType = Enum.ScaleType.Fit
   iconImage.ZIndex = 3
   iconImage.Parent = circleBg
   -- Type title label (e.g. "Error", "Info")
   local typeTitleLabel = Instance.new("TextLabel")
   typeTitleLabel.Size = UDim2.new(1, -85, 0, 20)
   typeTitleLabel.Position = UDim2.new(0, 72, 0, 8)
   typeTitleLabel.BackgroundTransparency = 1
   typeTitleLabel.Text = typeConfig.title
   typeTitleLabel.TextColor3 = typeConfig.color
   typeTitleLabel.Font = Enum.Font.GothamBold
   typeTitleLabel.TextSize = 14
   typeTitleLabel.TextXAlignment = Enum.TextXAlignment.Left
   typeTitleLabel.TextYAlignment = Enum.TextYAlignment.Center
   typeTitleLabel.TextTransparency = 1
   typeTitleLabel.ZIndex = 4
   typeTitleLabel.Parent = notifContainer
   -- Message text
   local titleLabel = Instance.new("TextLabel")
   titleLabel.Size = UDim2.new(1, -85, 0, _NOTIF_HEIGHT - 32)
   titleLabel.Position = UDim2.new(0, 72, 0, 28)
   titleLabel.BackgroundTransparency = 1
   titleLabel.Text = message
   titleLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
   titleLabel.Font = Enum.Font.Gotham
   titleLabel.TextSize = 13
   titleLabel.TextXAlignment = Enum.TextXAlignment.Left
   titleLabel.TextYAlignment = Enum.TextYAlignment.Top
   titleLabel.TextTransparency = 1
   titleLabel.TextWrapped = true
   titleLabel.ZIndex = 4
   titleLabel.Parent = notifContainer
   -- Timer bar at bottom (colored line that drains from right to left)
   local timerBar = Instance.new("Frame")
   timerBar.Size = UDim2.new(1, -10, 0, 3)
   timerBar.Position = UDim2.new(0, 5, 1, -6)
   timerBar.AnchorPoint = Vector2.new(0, 0)
   timerBar.BackgroundColor3 = typeConfig.color
   timerBar.BorderSizePixel = 0
   timerBar.BackgroundTransparency = 1
   timerBar.ZIndex = 5
   timerBar.Parent = notifContainer
   Instance.new("UICorner", timerBar).CornerRadius = UDim.new(0, 2)
   _playSound(_NOTIF_SOUND, 3.5)
   task.spawn(function()
       -- Fade in: background + all elements
       _TweenService:Create(notifContainer, TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {BackgroundTransparency = 0}):Play()
       _TweenService:Create(stroke, TweenInfo.new(0.4), {Transparency = 0.5}):Play()
       _TweenService:Create(circleBg, TweenInfo.new(0.4), {ImageTransparency = 0.65}):Play()
       _TweenService:Create(circleGlow, TweenInfo.new(0.4), {Transparency = 0.3}):Play()
       _TweenService:Create(iconImage, TweenInfo.new(0.4), {ImageTransparency = 0}):Play()
       typeTitleLabel.TextTransparency = 0
       titleLabel.TextTransparency = 0
       task.spawn(function() _animateNotifText(typeTitleLabel, typeConfig.title) end)
       task.spawn(function() _animateNotifText(titleLabel, message) end)
       _TweenService:Create(timerBar, TweenInfo.new(0.3), {BackgroundTransparency = 0}):Play()
       -- Start timer bar drain (right to left by shrinking width)
       task.wait(0.3)
       _TweenService:Create(timerBar, TweenInfo.new(_NOTIF_DURATION, Enum.EasingStyle.Linear), {Size = UDim2.new(0, 0, 0, 3)}):Play()
       -- Wait for duration
       task.wait(_NOTIF_DURATION)
       -- Determine fade-out direction
       local fadeOffset = -30
       local myIndex
       for i, e in ipairs(_activeNotifications) do
           if e == thisEntry then myIndex = i break end
       end
       if myIndex and #_activeNotifications > 1 and myIndex < #_activeNotifications then
           fadeOffset = 30
       end
       -- Fade out
       local curPos = notifContainer.Position
       _TweenService:Create(notifContainer, TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
           BackgroundTransparency = 1,
           Position = UDim2.new(curPos.X.Scale, curPos.X.Offset, curPos.Y.Scale, curPos.Y.Offset + fadeOffset)
       }):Play()
       _TweenService:Create(stroke, TweenInfo.new(0.35), {Transparency = 1}):Play()
       _TweenService:Create(circleBg, TweenInfo.new(0.3), {ImageTransparency = 1}):Play()
       _TweenService:Create(circleGlow, TweenInfo.new(0.3), {Transparency = 1}):Play()
       _TweenService:Create(iconImage, TweenInfo.new(0.3), {ImageTransparency = 1}):Play()
       _TweenService:Create(typeTitleLabel, TweenInfo.new(0.3), {TextTransparency = 1}):Play()
       _TweenService:Create(titleLabel, TweenInfo.new(0.3), {TextTransparency = 1}):Play()
       _TweenService:Create(timerBar, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()
       task.wait(0.5)
       _removeNotification(thisEntry)
       notifGui:Destroy()
   end)
end
