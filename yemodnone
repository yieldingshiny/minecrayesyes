	        Color3.new(0.3, 0.3, 1),    -- Blue
	        Color3.new(0.7, 0, 1),      -- Purple
	        Color3.new(1, 0, 1),        -- Magenta
	        Color3.new(0, 1, 0.5),      -- Spring Green
	    }
	    return colors[(index - 1) % #colors + 1]
	end

	-- Trail folder
	local trailFolder = Instance.new("Folder")
	trailFolder.Name = "_ArrowTrails"
	trailFolder.Parent = workspace

	local function getProjectilesFolder()
	    local ub = workspace:FindFirstChild("Unbreakable")
	    if not ub then return nil end
	    return ub:FindFirstChild("Projectiles")
	end

	local function isMyArrow(arrow)
	    local attackerVal = arrow:FindFirstChild("Attacker")
	    if not attackerVal or not attackerVal:IsA("ObjectValue") then return false end
	    local attacker = attackerVal.Value
	    if not attacker then return false end
	    -- Attacker value can point to the player or the character
	    if attacker == LocalPlayer then return true end
	    if attacker == LocalPlayer.Character then return true end
	    -- sometimes it points to humanoid or a child — check parent chain
	    if attacker.Parent == LocalPlayer.Character then return true end
	    if attacker:IsA("Player") and attacker == LocalPlayer then return true end
	    return false
	end

	local function createSegment(from, to, customColor)
	    local distance = (to - from).Magnitude
	    if distance < 0.01 then return nil end

	    local part = Instance.new("Part")
	    part.Name = "TrailSeg"
	    part.Anchored = true
	    part.CanCollide = false
	    part.CastShadow = false
	    part.Material = Enum.Material.Neon
	    part.Color = customColor or LINE_COLOR
	    part.Size = Vector3.new(LINE_THICKNESS, LINE_THICKNESS, distance)
	    part.CFrame = CFrame.lookAt((from + to) / 2, to)
	    part.Parent = trailFolder
	    return part
	end

	local function createLandingMarker(position)
	    local part = Instance.new("Part")
	    part.Name = "LandingMarker"
	    part.Anchored = true
	    part.CanCollide = false
	    part.CastShadow = false
	    part.Shape = Enum.PartType.Ball
	    part.Material = Enum.Material.Neon
	    part.Color = LANDING_MARKER_COLOR
	    part.Size = Vector3.new(LANDING_MARKER_SIZE, LANDING_MARKER_SIZE, LANDING_MARKER_SIZE)
	    part.CFrame = CFrame.new(position)
	    part.Parent = trailFolder
	    return part
	end

	local function clearTrailData(data)
	    for _, seg in ipairs(data.segments) do
	        if seg and seg.Parent then seg:Destroy() end
	    end
	    if data.landingMarker and data.landingMarker.Parent then
	        data.landingMarker:Destroy()
	    end
	end

	local function startTrackingArrow(arrow)
	    if trackedArrows[arrow] then return end
	    if not isMyArrow(arrow) then return end

	    local colorIndex = 1
	    if rgbTracerEnabled then
	        colorIndex = math.random(1, 8)
	    end

	    local data = {
	        positions = {},
	        segments = {},
	        landingMarker = nil,
	        alive = true,
	        lastSampleTime = 0,
	        colorIndex = colorIndex,
	    }
	    trackedArrows[arrow] = data

	    -- record initial position
	    local pos = arrow.Position
	    table.insert(data.positions, pos)

	    -- sample loop via Heartbeat
	    local heartbeatConn
	    heartbeatConn = RunService.Heartbeat:Connect(function()
	        if not tracerEnabled then
	            heartbeatConn:Disconnect()
	            return
	        end

	        -- arrow still exists?
	        if not arrow or not arrow.Parent then
	            data.alive = false
	            heartbeatConn:Disconnect()

	            -- place landing marker at last known position
	            if #data.positions > 0 then
	                local markerPos = data.positions[#data.positions]
	                local markerColor
	                if rgbTracerEnabled then
	                    markerColor = getRainbowColor(data.colorIndex)
	                else
	                    markerColor = LANDING_MARKER_COLOR
	                end
	                local part = Instance.new("Part")
	                part.Name = "LandingMarker"
	                part.Anchored = true
	                part.CanCollide = false
	                part.CastShadow = false
	                part.Shape = Enum.PartType.Ball
	                part.Material = Enum.Material.Neon
	                part.Color = markerColor
	                part.Size = Vector3.new(LANDING_MARKER_SIZE, LANDING_MARKER_SIZE, LANDING_MARKER_SIZE)
	                part.CFrame = CFrame.new(markerPos)
	                part.Parent = trailFolder
	                data.landingMarker = part
	            end

	            -- schedule cleanup after tracer lifespan (seconds)
	            local life = (S and S.arrowTracerLifespan) or TRAIL_LIFETIME
	            task.delay(life, function()
	                if trackedArrows[arrow] then
	                    clearTrailData(data)
	                    trackedArrows[arrow] = nil
	                end
	            end)
	            return
	        end

	        -- throttle sampling
	        local now = tick()
	        if now - data.lastSampleTime < SAMPLE_INTERVAL then return end
	        data.lastSampleTime = now

	        local newPos = arrow.Position
	        local prevPos = data.positions[#data.positions]
	        if not prevPos or (newPos - prevPos).Magnitude > 0.05 then
	            table.insert(data.positions, newPos)
	            if prevPos then
	                local segColor
	                if rgbTracerEnabled then
	                    segColor = getRainbowColor(data.colorIndex)
	                else
	                    segColor = LINE_COLOR
	                end
	                local seg = createSegment(prevPos, newPos, segColor)
	                if seg then
	                    table.insert(data.segments, seg)
	                end
	            end
	        end
	    end)

	    table.insert(connections, heartbeatConn)
	end

	local function scanExistingArrows()
	    local projectiles = getProjectilesFolder()
	    if not projectiles then return end

	    for _, child in ipairs(projectiles:GetChildren()) do
	        if child:IsA("BasePart") or child:IsA("Model") then
	            task.spawn(function()
	                startTrackingArrow(child)
	            end)
	        end
	    end
	end

	local function waitForProjectilesFolder()
	    while true do
	        local folder = getProjectilesFolder()
	        if folder then return folder end
	        task.wait(1)
	    end
	end

	local function startTracerListening()
	    local projectiles = workspace:FindFirstChild("Unbreakable")
	    if not projectiles then
	        task.spawn(function()
	            while tracerEnabled do
	                projectiles = workspace:FindFirstChild("Unbreakable")
	                if projectiles then break end
	                task.wait(1)
	            end
	            if not tracerEnabled then return end
	            projectiles = projectiles:FindFirstChild("Projectiles")
	            if not projectiles then return end

	            childAddedConn = projectiles.ChildAdded:Connect(function(child)
	                if not tracerEnabled then return end
	                task.wait(0.05)
	                startTrackingArrow(child)
	            end)
	            table.insert(connections, childAddedConn)
	            scanExistingArrows()
	        end)
	        return
	    end

	    projectiles = projectiles:FindFirstChild("Projectiles")
	    if not projectiles then return end

	    childAddedConn = projectiles.ChildAdded:Connect(function(child)
	        if not tracerEnabled then return end
	        task.wait(0.05)
	        startTrackingArrow(child)
	    end)
	    table.insert(connections, childAddedConn)
	    scanExistingArrows()
	end

	local function stopTracerListening()
	    for _, conn in ipairs(connections) do
	        if conn and conn.Connected then conn:Disconnect() end
	    end
	    connections = {}
	    childAddedConn = nil

	    for arrow, data in pairs(trackedArrows) do
	        clearTrailData(data)
	    end
	    trackedArrows = {}

	    for _, child in ipairs(trailFolder:GetChildren()) do
	        child:Destroy()
	    end
	end

