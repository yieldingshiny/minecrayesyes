    local function _formatCooldownDuration(sec)
        sec = math.max(0, math.floor(sec + 0.5))
        if sec <= 0 then return "no time" end
        local h = math.floor(sec / 3600)
        local m = math.floor((sec % 3600) / 60)
        local s = sec % 60
        if h > 0 then
            return string.format("%d hour%s %d minute%s", h, h == 1 and "" or "s", m, m == 1 and "" or "s")
        end
        if m > 0 then
            return string.format("%d minute%s %d second%s", m, m == 1 and "" or "s", s, s == 1 and "" or "s")
        end
        return string.format("%d second%s", s, s == 1 and "" or "s")
    end

    local function _getFeedbackCooldownRemaining()
        local now = os.time()
        local last = _readFeedbackLastSubmitTime()
        if last > 0 and now - last < _FEEDBACK_COOLDOWN_SEC then
            return _FEEDBACK_COOLDOWN_SEC - (now - last)
        end
        local left = _sessionFeedbackCooldownEnd - tick()
        if left > 0 then return left end
        return 0
    end

    local function _formatCompactDuration(sec)
        sec = math.max(0, math.floor(sec + 0.5))
        local h = math.floor(sec / 3600)
        local m = math.floor((sec % 3600) / 60)
        local s = sec % 60
        return string.format("%dh %dm %ds", h, m, s)
    end

