do
   local staffCache = S._staffCache -- UserId -> {rank, roleName} or false (not staff)
   local function checkPlayer(player)
       if player == _Players.LocalPlayer then return end
       task.spawn(function()
           local rank = 0
           local roleName = "Unknown"
           pcall(function()
               rank = player:GetRankInGroup(_FOB_ADMIN_GROUP_ID)
               roleName = player:GetRoleInGroup(_FOB_ADMIN_GROUP_ID)
           end)
           -- Also check the official FOB group for Moderators rank
           if rank == 0 then
               pcall(function()
                   local officialRole = player:GetRoleInGroup(_FOB_OFFICIAL_GROUP_ID)
                   if officialRole == "Moderators" then
                       rank = 1
                       roleName = "Moderators"
                   end
               end)
           end
           if rank > 0 then
               staffCache[player.UserId] = {rank = rank, roleName = roleName}
               if S.staffNotifyEnabled then
                   spawnNotification("STAFF ALERT: " .. player.Name .. " (" .. roleName .. ") joined!", "warning")
               end
               if S.staffKickEnabled then
                   local kickMsg = "Staff detected in your server: " .. player.Name .. " (" .. roleName .. ")"
                   _Players.LocalPlayer:Kick(kickMsg)
               end
           else
               staffCache[player.UserId] = false
           end
       end)
   end
   -- Remove player from cache when they leave so re-joins are detected
   _Players.PlayerRemoving:Connect(function(player)
       staffCache[player.UserId] = nil
   end)
   _Players.PlayerAdded:Connect(function(player)
       checkPlayer(player)
   end)
   -- Scan current players when a toggle is enabled (uses cached rank data)
   _scanCurrentStaff = function(mode)
       for _, player in pairs(_Players:GetPlayers()) do
           if player ~= _Players.LocalPlayer then
               local cached = staffCache[player.UserId]
               if cached then
                   -- Player is known staff, act immediately
                   if mode == "notify" then
                       spawnNotification("STAFF ALERT: " .. player.Name .. " (" .. cached.roleName .. ") is in server!", "warning")
                   elseif mode == "kick" then
                       local kickMsg = "Staff detected in your server: " .. player.Name .. " (" .. cached.roleName .. ")"
                       _Players.LocalPlayer:Kick(kickMsg)
                   end
               elseif cached == nil then
                   -- Player hasn't been checked yet, check them now
                   checkPlayer(player)
               end
           end
       end
   end
   -- Check existing players on script load
   task.spawn(function()
       for _, player in pairs(_Players:GetPlayers()) do
           checkPlayer(player)
       end
   end)
end
