                           -- eggSetupDone stays true — no re-dupe/invis
                       end
                       -- Find closest egg target if we don't have one
                       if not eggCurrentTarget then
                           local target, targetPart = findEggTarget()
                           if target and targetPart then
                               eggCurrentTarget = target
                               eggMode = "egg"
                               S.eggIsFollowing = true
                               spawnNotification("Egg target found! Attacking...")
                               -- One-time setup: dupe + invis (only after enable/death)
                               if not eggSetupDone then
                                   spawnNotification("Egg farm starting! Preparing...")
                                   doEggSetup()
                                   eggSetupDone = true
                                   -- Re-read root position after setup
                                   local freshChar = _Players.LocalPlayer.Character
                                   local freshRoot = freshChar and freshChar:FindFirstChild("HumanoidRootPart")
                                   if freshRoot then
                                       eggHoldCF = CFrame.new(freshRoot.Position) * CFrame.Angles(math.pi / 2, 0, 0)
                                   else
                                       eggHoldCF = CFrame.new(root.Position) * CFrame.Angles(math.pi / 2, 0, 0)
                                   end
                               end
                               ensureEggHoldConnection()
                               -- Move to target (tween or teleport)
                               if S.eggAutofarmEnabled and targetPart and targetPart.Parent then
                                   local targetPos = targetPart.Position - Vector3.new(0, 4.5, 0)
                                   if S.eggFarmMethod == "Tween" then
                                       local startCF = eggHoldCF or CFrame.new(root.Position)
                                       local startPos = startCF.Position
                                       local dist = (startPos - targetPos).Magnitude
                                       local tweenTime = math.clamp(dist / S.eggTweenSpeed, 0.3, 6)
                                       eggTweening = true
                                       local elapsed = 0
                                       while elapsed < tweenTime and S.eggAutofarmEnabled and eggCurrentTarget and eggCurrentTarget.Parent do
                                           elapsed = elapsed + task.wait()
                                           local alpha = math.min(elapsed / tweenTime, 1)
                                           local freshPart = getTargetPart(eggCurrentTarget)
                                           if freshPart then
                                               targetPos = freshPart.Position - Vector3.new(0, 4.5, 0)
                                           end
                                           local tweenedPos = startPos:Lerp(targetPos, alpha)
                                           eggHoldCF = CFrame.new(tweenedPos) * CFrame.Angles(math.pi / 2, 0, 0)
                                       end
                                       eggTweening = false
                                   else
                                       eggHoldCF = CFrame.new(targetPos) * CFrame.Angles(math.pi / 2, 0, 0)
                                   end
                               end
                               -- Hold connection now auto-follows the egg target
                           end
                       end
                   else
                       -- NOT on Chocolate Kingdom: kill opposite general + vote for CK
                       -- If we were in egg mode, switch to general mode (keep setup!)
                       if eggMode == "egg" then
                           eggCurrentTarget = nil
                           eggTweening = false
                           eggMode = nil
                           -- Keep eggSetupDone, keep eggHoldConn, keep eggHoldCF
                       end
                       -- Check if general target died — just clear target
                       if eggCurrentTarget and not isTargetAlive(eggCurrentTarget) then
                           spawnNotification("General killed! Voting for Chocolate Kingdom...")
                           eggCurrentTarget = nil
                           eggTweening = false
                           -- eggSetupDone stays true — no re-dupe/invis
                           voteChocolateKingdom()
                           eggVoteDebounce = true
                       end
                       -- Find general if we don't have a target
                       if not eggCurrentTarget then
                           local targetGeneral, targetPart = findOppositeGeneral()
                           if targetGeneral and targetPart and isTargetAlive(targetGeneral) then
                               eggCurrentTarget = targetGeneral
                               eggMode = "general"
                               S.eggIsFollowing = true
                               spawnNotification("Not on Chocolate Kingdom! Killing general...")
                               -- One-time setup (only after enable/death)
                               if not eggSetupDone then
                                   spawnNotification("Egg farm starting! Preparing...")
                                   doEggSetup()
                                   eggSetupDone = true
                                   local freshChar = _Players.LocalPlayer.Character
                                   local freshRoot = freshChar and freshChar:FindFirstChild("HumanoidRootPart")
                                   if freshRoot then
                                       eggHoldCF = CFrame.new(freshRoot.Position) * CFrame.Angles(math.pi / 2, 0, 0)
                                   else
                                       eggHoldCF = CFrame.new(root.Position) * CFrame.Angles(math.pi / 2, 0, 0)
                                   end
                               end
                               ensureEggHoldConnection()
                               -- Move to general
                               if S.eggAutofarmEnabled and targetPart and targetPart.Parent then
                                   local targetPos = targetPart.Position - Vector3.new(0, 4.5, 0)
                                   if S.eggFarmMethod == "Tween" then
                                       local startCF = eggHoldCF or CFrame.new(root.Position)
                                       local startPos = startCF.Position
                                       local dist = (startPos - targetPos).Magnitude
                                       local tweenTime = math.clamp(dist / S.eggTweenSpeed, 0.3, 6)
                                       eggTweening = true
                                       local elapsed = 0
                                       while elapsed < tweenTime and S.eggAutofarmEnabled and isTargetAlive(eggCurrentTarget) do
                                           elapsed = elapsed + task.wait()
                                           local alpha = math.min(elapsed / tweenTime, 1)
                                           local _, freshTp = findOppositeGeneral()
                                           if freshTp and freshTp.Parent then
                                               targetPos = freshTp.Position - Vector3.new(0, 4.5, 0)
                                           end
                                           local tweenedPos = startPos:Lerp(targetPos, alpha)
                                           eggHoldCF = CFrame.new(tweenedPos) * CFrame.Angles(math.pi / 2, 0, 0)
                                       end
                                       eggTweening = false
                                   else
                                       eggHoldCF = CFrame.new(targetPos) * CFrame.Angles(math.pi / 2, 0, 0)
                                   end
                               end
                               -- Hold connection now auto-follows the general
                           else
                               -- No general found or already dead — vote for CK
                               if not eggVoteDebounce then
                                   voteChocolateKingdom()
                                   eggVoteDebounce = true
                               end
                           end
                       end
                   end
               else
                   -- Player died: fully reset everything so dupe+invis re-runs on respawn
                   if eggSetupDone or eggCurrentTarget or eggHoldCF then
                       cleanupEggFarm()
                       eggSetupDone = false
                       eggTweening = false
                       if S.eggAutoInvisEnabled and S._invisEnabled then disableInvis() end
                   end
               end
