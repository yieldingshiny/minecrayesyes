       -- Priority: Eggs (Blue/Pink/Yellow/Green) are preferred targets.
       -- Non-priority easter NPCs are only picked if they are closer than the closest egg.
       local function findEggTarget()
           local char = _Players.LocalPlayer.Character
           local root = char and char:FindFirstChild("HumanoidRootPart")
           if not root then return nil, nil end
           local unbreakable = workspace:FindFirstChild("Unbreakable")
           if not unbreakable then return nil, nil end
           -- Track closest priority egg and closest non-priority NPC separately
           local bestEgg = nil
           local bestEggPart = nil
           local bestEggDist = math.huge
           local bestNpc = nil
           local bestNpcPart = nil
           local bestNpcDist = math.huge
           -- Check priority eggs in Undead folder (dynamically find all models ending in " Egg")
           local undead = unbreakable:FindFirstChild("Undead")
           if undead then
               for _, child in pairs(undead:GetChildren()) do
                   if child:IsA("Model") and child.Name:match(" Egg$") then
                       local hum = child:FindFirstChildOfClass("Humanoid")
                       if hum and hum.Health > 0 then
                           local part = child.PrimaryPart
                           if not part then
                               for _, pn in ipairs({"HumanoidRootPart", "Torso", "LowerTorso", "UpperTorso", "Head"}) do
                                   local f = child:FindFirstChild(pn)
                                   if f and f:IsA("BasePart") then part = f break end
                               end
                           end
                           if part then
                               local dist = (root.Position - part.Position).Magnitude
                               if dist < bestEggDist then
                                   bestEggDist = dist
                                   bestEgg = child
                                   bestEggPart = part
                               end
                           end
                       end
                   end
               end
           end
           -- Check non-priority easter NPCs in Characters folders (OPPOSITE team only)
           local chars = unbreakable:FindFirstChild("Characters")
           if chars then
               local enemyTeams = {}
               local playerTeam = _Players.LocalPlayer.Team
               if playerTeam then
                   local tName = playerTeam.Name:lower()
                   if tName:find("human") then
                       table.insert(enemyTeams, "Orc")
                       table.insert(enemyTeams, "Undead")
                   elseif tName:find("orc") then
                       table.insert(enemyTeams, "Human")
                       table.insert(enemyTeams, "Undead")
                   else
                       enemyTeams = {"Human", "Orc", "Undead"}
                   end
               else
                   enemyTeams = {"Human", "Orc", "Undead"}
               end
