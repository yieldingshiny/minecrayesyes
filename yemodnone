   local function listConfigs()
       local configs = {}
       pcall(function()
           if not listfiles then return end
           local files = listfiles(_configPath)
           for _, f in pairs(files) do
               local name = f:match("([^/\\]+)%.cfg$")
               if name then table.insert(configs, name) end
           end
       end)
       return configs
   end
   -- Auto-load config file path
   local _autoLoadPath = _configPath .. "/autoload.txt"
   local function getAutoLoadConfig()
       local ok, data = pcall(function()
           if not readfile then return nil end
           if not isfile(_autoLoadPath) then return nil end
           return readfile(_autoLoadPath)
       end)
       return ok and data or nil
   end
   local function setAutoLoadConfig(name)
       pcall(function()
           if not writefile then return end
           if name then
               writefile(_autoLoadPath, name)
           else
               writefile(_autoLoadPath, "")
           end
       end)
   end
